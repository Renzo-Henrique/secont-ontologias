import nucleo

package despesas






/*
Ano numeric Ana de referência da realização da despesa
Data timestamp Data de referência da realização da despesa
ValorEmpenho text Valor que foi reservado para pagamento de um produto ou serviço.


*/
relator DespesaReificada {

    // Ana de referência da realização da despesa
    ano: number [1]
    // Data de referência da realização da despesa
    data: datetime [1]
    // Valor que foi reservado para pagamento de um produto ou serviço.
    valorEmpenho: string [1]
    // Valor que indica os produtos entregues ou serviços prestados pelos fornecedores ao governo que já foram atestados (conferidos) pelo órgão contratante.
    valorLiquidado: string [1]
    // Valor pago ao fornecedor referente ao produto ou serviço prestado
    valorPago: string [1]
    // Valor pago no período realizado, mas que teve seu empenho realizado no ano anterior
    valorRap: string [1]
    // CPF CNPJ ou NIS do favorecido
    // - cpfCnpjNis: string [1]
    // Código que ser refere ao tipo de favorecido: pessoa jurídica, física, órgão/entidade ou credor genérico
    tipoFavorecido: string [1]
    // Cargo ou função a que se refere à pessoa física, quando servidor público.
    cargoFuncao: string [1]
    // Quem recebeu o recurso pela prestação de serviço ou pela entrega do produto
    favorecido: string [1]
    // Código de identificação do Favorecido
    idFavorecido: string [1]
    // É a modalidade de licitação que a Administração Pública realizou a contratação.
    tipoLicitacao: string [1]
    // Texto livre sobre a destinação da despesa
    historicoDocumento: string [1]
    // Código do Documento de Empenho ou Código do Documento de Liquidação ou Código do Documento de Pagamento
    documento: string [1]
    // Código do Documento de Empenho
    documentoEmpenho: string [1]
    // Código do processo a que se refere à despesa
    codigoProcesso: string [1]
    // Conjunto de documentos, informações ou quaisquer outros elementos referenciados por um número de controle sequencial.
    processo: string [1]
    // Assunto referente ao processo.
    processoAssunto: string [1]
    // Maior nível de agregação das diversas áreas de atuação do setor público. Está relacionada com a missão institucional fundamental do órgão executor, por exemplo, cultura, educação, saúde ou defesa.
    codigoFuncionalProgramatica: string [1]
    // Indica se a despesa é corrente ou de capital
    codigoCategoriaEconomica: string [1]
    // Classificação detalhada da receita e despesa, com a finalidade de analisar a arrecadação e a despesa do governo.
    categoriaEconomica: string [1]
    // Código de identificação da Unidade Gestora
    // - codigoUnidadeGestora: string [1]
    // Entidades encarregadas de gerir os recursos públicos.
    // - unidadeGestora: string [1]
    // Código grupo de despesa
    codigoGrupoDespesa: string [1]
    // Agregação de elementos de despesa de mesmas características quanto ao objeto de gasto
    grupoDespesa: string [1]
    // Código elemento
    codigoElementoDespesa: string [1]
    // Classificação que tem por finalidade identificar os objetos de gastos no âmbito de cada GND, tais como vencimentos e vantagens fixas, juros, diárias, material de consumo, serviços de terceiros prestados sob qualquer forma, subvenções sociais, obras e instalações, equipamentos e material permanente, auxílios, amortização e outros que a Administração Pública utiliza para a consecução de seus fins.
    elementoDespesa: string [1]
    // Descrição do elemento de Despesa
    descricaoElementoDespesa: string [1]
    // Código de identificação do Subtitulo
    codigoSubtitulo: string [1]
    // Indica em qual localidade a despesa foi realizada.
    subtitulo: string [1]
    // Código de identificação da Fonte
    codigoFonte: string [1]
    // É a indicação detalhada de onde vem o dinheiro que está financiando cada item da Despesa realizada pelo governo.
    fonte: string [1]
    // Código de identificação do Órgão
    codigoOrgao: string [1]
    // Denominação dada as unidades responsáveis pelo desempenho das funções de governo.
    orgao: string [1]
    // Código de identificação da Função
    codigoFuncao: string [1]
    // É o gasto do governo agrupado nas diversas áreas de atuação, com a finalidade de atingir seus objetivos. Exemplo: Educação, Saúde, Segurança Pública e outras
    funcao: string [1]
    // Código de identificação da Subfuncao
    codigoSubFuncao: string [1]
    // Detalhamento das áreas de atuação do governo.
    subFuncao: string [1]
    // Código Programa
    codigoPrograma: string [1]
    // Instrumento de organização da atuação governamental. Articula um conjunto de ações que concorrem à concretização dos objetivos pretendidos, sendo mensurado por indicadores estabelecidos no plano plurianual.
    programa: string [1]
    // Código de identificação da Ação
    codigoAcao: string [1]
    // Atividade que o governo precisa realizar para atender a necessidade da população.
    acao: string [1]
    // Código de identificação da Modalidade
    codigoModalidade: string [1]
    // Indicação de como estão sendo gastos os recursos do governo.
    modalidade: string [1]
    // Código de identificação do Subelemento de Despesa
    codigoSubElementoDespesa: string [1]
    // É uma subdivisão do elemento de despesa, indicando mais detalhadamente em quê a despesa se enquadra, ou seja, é uma subcategoria da despesa.
    subElementoDespesa: string [1]
    // Corresponde a um código complementar da tabela de Unidades Gestoras do SIGEFES. (acho que nem deveria constar no portal, pois na prática não tem utilidade)
    codigoGestaoEmitente: string [1]
    // Código plano orçamentário
    codigoPlanoOrcamentario: string [1]
    // Identificação orçamentária parcial ou total de uma ação, de caráter gerencial - ou seja, não constante na LOA -, informada na etapa de execução orçamentária e vinculada à ação orçamentária, que tem por finalidade permitir que tanto a elaboração do orçamento quanto o acompanhamento físico e financeiro da execução ocorram num nível mais detalhado do que o do subtítulo (localizador de gasto) da ação.
    planoOrcamentario: string [1]
    // Número do processo cadastrado no Sistema Eletrônico de Protocolo - SEP ou outro que o substitua.
    numeroProcesso: string [1]
    // Código do convênio recebido atrelado a despesa
    codigoConvenioRecebido: string [1]
    // Código do convênio cedido atrelado a despesa
    codigoConvenioConcedido: string [1]
    // Código do sistema
    id: string [1]
    
}

role UnidadeGestoraNaDespesa specializes nucleo.UnidadeGestora {
    label {
        @pt-br "Unidade Gestora na Despesa"
    }
    description {
        @pt-br "Unidade Gestora na Despesa"
    }
    
}

role PessoaJuridicaNaDespesa specializes nucleo.PessoaJuridica, FavorecidoNaDespesa {
    label {
        @pt-br "Pessoa Jurídica na Despesa"
    }
    description {
        @pt-br "Pessoa Jurídica na Despesa"
    }
    
}

role PessoaFisicaNaDespesa specializes nucleo.PessoaFisica, FavorecidoNaDespesa {
    label {
        @pt-br "Pessoa Física na Despesa"
    }
    description {
        @pt-br "Pessoa Física na Despesa"
    }
    
}

roleMixin FavorecidoNaDespesa {
    label {
        @pt-br "Favorecido na Despesa"
    }
    description {
        @pt-br "Favorecido na Despesa"
    }
    
}

disjoint complete genset GenSetFavorecidoNaDespesa {
    general FavorecidoNaDespesa
    specifics PessoaJuridicaNaDespesa, PessoaFisicaNaDespesa
}


@mediation relation despesaReificada [1..*] -- [1] FavorecidoNaDespesa