role UnidadeGestoraEmitenteDeDespesa specializes nucleo.UnidadeGestora

relator RegistroDeDespesaOrcamentaria {
  @mediation [1]  -- formalizadaPor -- [1] (const) DocumentoContabilDeDespesaOrcamentaria
  @mediation [1..*] -- temUnidadeGestoraEmitenteDeDespesa -- [1] (const) UnidadeGestoraEmitenteDeDespesa
  @mediation [1] -- [1] (const) nucleo.MicroRegiao
  @mediation [1] -- [1] (const) nucleo.Municipio
}


relator ClassificadorDeDespesaOrcamentaria {
  @mediation [1..*] -- [1] (const) ClassificadorInstitucionalDeDespesa
  @mediation [1..*] -- [1] (const) ClassificadorFuncionalDeDespesa
  @mediation [1..*] -- [1] (const) ClassificadorPorEstruturaProgramaticaDeDespesa
  @mediation [1..*] -- [1] (const) ClassificadorPorNaturezaDeDespesa
  @mediation [1..*] -- [1] (const) FonteDaDespesa
  @mediation [1]  -- ClassificadorDocumentalDe -- [1] (const) DocumentoContabilDeDespesaOrcamentaria
}

