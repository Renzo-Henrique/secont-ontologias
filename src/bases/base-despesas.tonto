  CodigoCategoriaEconomica,
  CodigoConvenioConcedido,
  CodigoConvenioRecebido,  ---> Nulos
  CodigoDetalhamentoFonte,
  CodigoElementoDespesa,
  CodigoFonte,
  CodigoFuncao,
  CodigoFuncionalProgramatica,   ---> Zeros
  CodigoGestaoEmitente,
  CodigoGrupoDespesa,
  CodigoModalidade,
  CodigoOrgao,
  CodigoPlanoOrcamentario,  ---> Nulos
  CodigoProcesso,
  CodigoPrograma,
  CodigoSubFuncao,
  CodigoSubelementoDespesa,
  CodigoSubtitulo,
