/// @namespace https://example.org/ontologia-portal-transparencia-es/base-despesas-restos-a-pagar#
ontology base-despesas-restos-a-pagar
import nucleo from <../../nucleo/nucleo.tonto>
import base-despesas from <base-despesas.tonto>

role UnidadeGestoraComRestosAPagar specializes nucleo.UnidadeGestora



subkind DespesaDeExercicioAnterior specializes nucleo.DocumentoContabil
disjoint genset DespesaPorVigencia where base-despesas.DespesaDeExercicioVigente, DespesaDeExercicioAnterior specializes nucleo.DocumentoContabil

/// São Restos a Pagar todas as despesas regularmente empenhadas, do exercício atual ou anterior, mas não pagas até 31 de dezembro do exercício financeiro vigente. Distingue-se dois tipos de restos a pagar: os processados (despesas já liquidadas); e os não processados (despesas a liquidar ou em liquidação).
/// Cite MCASP - 11º Edição: Parte I: Seção 4.7
historicalRole DocumentoContabilDeRestosAPagar specializes DespesaDeExercicioAnterior{
    @creation (const) [1] -- [1] (const) CriacaoDeDespesaNaoPaga
}

datatype DadosDeRestosAPagarAnonimizados

relator RegistroDeRestosAPagar{
  @mediation (const) [1]  -- [1] (const) DocumentoContabilDeRestosAPagar
  @mediation [1..*] -- [1] (const) UnidadeGestoraComRestosAPagar
  @mediation (const) [1] -- ClassificadoPor -- [1] (const) base-despesas.ClassificadorPorNaturezaDeDespesa

  dadosAnonimizados: const  DadosDeRestosAPagarAnonimizados [1]
  poder: const  nucleo.PoderDaFederacao [1]
}

event CriacaoDeDespesaNaoPaga

/// No fim do exercício, as despesas orçamentárias empenhadas e não pagas serão inscritas em restos a pagar.
/// Cite MCASP - 11º Edição: Parte I: Seção 4.7.1
situation TerminoDoExercicioDeDespesaVigente{
  @triggering (const) [1] -- triggers -- [0..*] (addOnly) CriacaoDeDespesaNaoPaga
}

@termination relation base-despesas.DespesaDeExercicioVigente (const) [1]  -- [0..1] (addOnly) CriacaoDeDespesaNaoPaga


