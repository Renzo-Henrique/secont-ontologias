package nucleo

datatype CodigoUnidadeGestora specializes string
kind UnidadeGestora {
    label {
        @en "Gestional Unit"
        @pt-br "Unidade Gestora"
    }
    description {
        @en ""
        @pt-br ""
    }
    
    codigo: CodigoUnidadeGestora [1] {const}
    descricao: string [1]
}


datatype Cpf specializes string
datatype Nis specializes string
kind PessoaFisica {
    label {
        @en "Natural Person"
        @pt-br "Pessoa Física"
    }
    description {
        @en ""
        @pt-br ""
    }
    
    cpf: Cpf [1] {const}
    nis: Nis [0..1] {const}
    nome: string [1]
}

datatype Cnpj specializes string

kind PessoaJuridica {
    label {
        @en "Legal Person"
        @pt-br "Pessoa Jurídica"
    }
    description {
        @en ""
        @pt-br ""
    }
    
    cnpj: Cnpj [1] {const}
    nome: string [1]
}
