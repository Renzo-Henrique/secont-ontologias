/// @namespace https://example.org/ontologia-portal-transparencia-es/nucleo#
ontology nucleo

/// @pt-br 44 Portaria MTP 1.467/2022, Art.2º - Definições: VI - unidade gestora: entidade ou órgão único, de natureza pública, de cada ente federativo, abrangendo todos os poderes, órgãos e entidades autárquicas e fundacionais, que tenha por finalidade a administração, o gerenciamento e a operacionalização do RPPS, incluindo a arrecada.
/// Cite Portaria MTP nº 1.467, de 2 junho de 2022: Capítulo I - Definições
role UnidadeGestora  specializes OrgaoPublico

/// @pt-br É a unidade de atuação dotada de personalidade jurídica;;
/// Cite LEI Nº 9.784 , DE 29 DE JANEIRO DE 1999.
role EntidadePublica specializes PessoaJuridica

/// @pt-br É a unidade de atuação integrante da estrutura da Administração direta e da estrutura da Administração indireta;
/// Cite LEI Nº 9.784 , DE 29 DE JANEIRO DE 1999.
kind OrgaoPublico {
    codigo: string [1]
    descricao: string [1]
    sigla: string [0..1]

    @componenthood [1..*] --<> [1] (const) EntidadePublica
}



/// @pt-br Constitui unidade orçamentária o agrupamento de serviços subordinados ao mesmo órgão ou repartição a que serão consignadas dotações próprias.
/// Cite LEI No 4.320, DE 17 DE MARÇO DE 1964
kind UnidadeDeOrgaoPublico{
    codigo: string [1]
    descricao: string [1]

    @componenthood [1..*] --<> [1] (const) OrgaoPublico
}


/// @pt-br Os órgãos orçamentários, por sua vez, correspondem a agrupamentos de unidades orçamentárias. As dotações são consignadas às unidades orçamentárias, responsáveis pela realização das ações.
/// Cite MCASP - 11º Edicao: Parte Il: Seções 4.2.1
role OrgaoPublicoOrcamentario specializes OrgaoPublico{

}

role UnidadeOrcamentaria specializes UnidadeDeOrgaoPublico{
    @componenthood [1..*] --<> [1] (const) OrgaoPublicoOrcamentario
}


/// @pt-br Pessoa natural identificada no modelo por CPF e nome, podendo também ter NIS informado.
kind PessoaFisica {
    
    cpf: string [1]
    nis: string [0..1]
    nome: string [1]
}


/// @pt-br Entidade com personalidade jurídica identificada no modelo por CNPJ e nome.
kind PessoaJuridica {
 
    cnpj: string [1]
    nome: string [1]
}

/// @pt-br Unidade territorial usada para agrupar municípios no contexto geográfico da ontologia.
kind Regiao

/// @pt-br Recorte geográfico formado por municípios e vinculado a uma região no modelo.
kind MicroRegiao {
    @componenthood [0..*] --<> [1] (const) Regiao
}

/// @pt-br Unidade territorial municipal relacionada à região e à microrregião correspondentes.
kind Municipio {
    @componenthood [0..*] --<> [1] (const) Regiao
    @componenthood [0..*] --<> [0..*] (const) MicroRegiao
}

/// @pt-br Instituição financeira referenciada nos dados do Portal da Transparência.
kind Banco{
    codigo: const string [1]
    codigoAgenciaOrigem: const string [1]
    codigoDomicilioBancarioOrigem: const string [1]
}

/// @pt-br  Convênios, contratos de repasse e termos de parceria são acordos feitos entre União e entidades governamentais dos demais entes da Federação, ou organizações não-governamentais, para transferência de recursos financeiros a serem utilizados na execução de um objetivo comum. Portanto, as transferências voluntárias e legais serão viabilizadas a partir dos mencionados instrumentos e outros congêneres.
/// Cite url https://portaldatransparencia.gov.br/entenda-a-gestao-publica/convenios-e-outros-acordos
kind Convenio{
    codigo: const string [1]
}

/// @pt-br Classificação que identifica o Poder da Federação ao qual uma unidade gestora está vinculada.
category PoderDaFederacao of functional-complexes{
    // EXECUTIVO, LEGISLATIVO, JUDICIARIO, DEFENSORIA_PUBLICA
    codigo: const string [1]
    descricao: const string [1]
} 

/// @pt-br Representação de informações pessoais que foram submetidas a processo de anonimização.
datatype DadosPessoaisAnonimizados{
    /// Codigo pode ser cpf, cnpj ou nis
    codigo: const string [1]
    nome: const string [1]
}

category FonteOrcamentaria of functional-complexes{
}
