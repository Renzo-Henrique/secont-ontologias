/// @namespace https://example.org/ontologia-portal-transparencia-es/nucleo#
ontology nucleo

/// @pt-br 44 Portaria MTP 1.467/2022, Art.2º - Definições: VI - unidade gestora: entidade ou órgão único, de natureza pública, de cada ente federativo, abrangendo todos os poderes, órgãos e entidades autárquicas e fundacionais, que tenha por finalidade a administração, o gerenciamento e a operacionalização do RPPS, incluindo a arrecada.
/// Cite Portaria MTP nº 1.467, de 2 junho de 2022: Capítulo I - Definições
kind UnidadeGestora {
    
    codigo: string [1]
    descricao: string [1]
}


// datatype Cpf specializes string
// datatype Nis specializes string
kind PessoaFisica {
    
    // cpf: Cpf [1] {const}
    // nis: Nis [0..1] {const}
    cpf: string [1]
    nis: string [0..1]
    nome: string [1]
}

//datatype Cnpj specializes string

kind PessoaJuridica {
 
    //cnpj: Cnpj [1] {const}
    cnpj: string [1]
    nome: string [1]
}

/// @pt-br O objetivo da elaboração e divulgação da informação contábil é fornecer informação para fins de prestação de contas e responsabilização (accountability) e tomada de decisão.
/// Cite MCASP - 11º Edicao: Parte Geral: Seções 2.3 ; 3.1
kind DocumentoContabil



kind Regiao

kind MicroRegiao{
    @componenthood [0..*] <>-- [1] Regiao
}

kind Municipio{
    @componenthood [0..*] <>-- [1] Regiao
    @componenthood [0..*] <>-- [0..*] MicroRegiao
}