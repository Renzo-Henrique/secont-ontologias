@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix base-receitas: <https://example.org/ontologia-portal-transparencia-es/base-receitas#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/base-receitas> a owl:Ontology ;
    owl:imports
        <http://purl.org/nemo/gufo#>,
        <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    vann:preferredNamespacePrefix "base-receitas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-receitas#" .

base-receitas:NaturezaDaReceita a owl:Class, gufo:Kind ;
    rdfs:label "NaturezaDaReceita" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:Quality,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoNatureza ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoNatureza ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoCategoria ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoCategoria ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoOrigem ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoOrigem ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoEspecie ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoEspecie ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento1 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento1 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento2 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento2 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento3 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento3 ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoTipo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoTipo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.ClassificaNaturezaDe ;
          owl:onClass base-receitas:DocumentoContabilDeReceitaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-receitas:FonteDaReceita a owl:Class, gufo:Kind ;
