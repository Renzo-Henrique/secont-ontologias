        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiada ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPara ] ;
          owl:someValuesFrom base-receitas:DocumentoContabilDeReceitaOrcamentaria ] .

base-receitas:DocumentoContabil a owl:Class, gufo:Kind ;
