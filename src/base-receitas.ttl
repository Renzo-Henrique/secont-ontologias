        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.dataEmissao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.dataContabilizacao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.documento ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.tipo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorRecolhidaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.ano ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.formalizadaPor ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:NaturezaDaReceita.ClassificaNaturezaDe ] ;
          owl:someValuesFrom base-receitas:NaturezaDaReceita ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:FonteDaReceita.ClassificaFonteDe ] ;
          owl:someValuesFrom base-receitas:FonteDaReceita ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:ContaContabil.ClassificaInformacaoContabilDe ] ;
          owl:someValuesFrom base-receitas:ContaContabil ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPor ;
          owl:someValuesFrom base-receitas:UnidadeGestoraEmitente ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPara ;
          owl:someValuesFrom base-receitas:UnidadeGestoraBeneficiada ] .

base-receitas:RegistroDeReceitaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeReceitaOrcamentaria" ;
