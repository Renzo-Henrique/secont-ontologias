base-receitas:UnidadeGestoraEmitente a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraEmitente" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitente ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPor ] ;
          owl:someValuesFrom base-receitas:DocumentoContabilDeReceitaOrcamentaria ] .

base-receitas:UnidadeGestoraBeneficiada a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraBeneficiada" ;
