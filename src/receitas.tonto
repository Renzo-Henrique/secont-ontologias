import nucleo
/**
 * Ontologia de Receitas Orçamentárias e Dívida Ativa do Estado do Espírito Santo
 * 
 * Esta ontologia modela:
 * 1. Receitas orçamentárias segundo a Lei Federal nº 4.320/64
 * 2. Registros de dívida ativa (CDA - Certidão de Dívida Ativa)
 * 
 * Fundação: UFO (Unified Foundational Ontology)
 */
package receitas

/**
 * Conta Contábil: Elemento do Plano de Contas do SIGEFES.
 * Representa a conta no plano de contas do qual o dado foi extraído.
 */
kind ContaContabil {
    label {
        @pt-br "Conta Contábil"
    }
    description {
        @pt-br "Corresponde a conta contábil, do plano de contas do SIGEFES, da qual foi extraído o dado."
    }
    
    codigoContaContabil: number [1]
    descricaoContaContabil: string [1]
}

kind NaturezaReceita {
    label {
        @pt-br "Natureza da Receita"
    }
    description {
        @pt-br "Agrupamento que identifica a origem dos recursos, se orçamentários ou extra- orçamentários. Busca identificar a origem dos recursos segundo o fato gerador. Constituem receitas orçamentárias os valores constantes da lei orçamentária, enquanto as extra- orçamentárias são todas aquelas provenientes de qualquer arrecadação que não figure no orçamento e, consequentemente, toda arrecadação que não constitui renda do Estado."
    }
    
    codigoNatureza: number [1]
    descricaoNatureza: string [1]
}

kind CategoriaReceita {
    label {
        @pt-br "Categoria da Receita"
    }
    description {
        @pt-br "A Lei Federal nº 4.320/64, em seu artigo 11, classifica a receita orçamentária em duas categorias econômicas: Receitas Correntes e Receitas de Capital. 
        Receitas Correntes: são arrecadadas dentro do exercício financeiro, aumentam as disponibilidades financeiras do Estado, em geral com efeito positivo sobre o Patrimônio Líquido e constituem instrumento para financiar os objetivos definidos nos programas e ações orçamentários, com vistas a satisfazer finalidades públicas.
        Receitas de Capital: também aumentam as disponibilidades financeiras do Estado e são instrumentos de financiamento dos programas e ações orçamentários, a fim de se atingirem as finalidades públicas. Porém, de forma diversa das Receitas Correntes, as Receitas de Capital em geral não provocam efeito sobre o Patrimônio Líquido.
        "
    }
    
    codigoCategoriaReceita: number [1]
    descricaoCategoriaReceita: string [1]
}

kind OrigemReceita {
    label {
        @pt-br "Origem da Receita"
    }
    description {
        @pt-br "É o detalhamento das Categorias Econômicas, que tem por objetivo identificar a natureza da procedência das receitas, no momento em que ingressam no Orçamento Público.
        Os códigos da Origem para as receitas correntes e de capital, de acordo com a Lei no 4.320, de 1964, são:
        RECEITAS CORRENTES
        1. Receita Tributária
        2. Receita de Contribuições
        3. Receita Patrimonial
        4. Receita Agropecuária
        5. Receita Industrial
        6. Receita de Serviços
        7. Transferências Correntes
        9. Outras Receitas Correntes
        RECEITAS DE CAPITAL
        1. Operações de Crédito
        2. Alienação de Bens
        3. Amortização de Empréstimos
        4. Transferências de Capital
        5. Outras Receitas de Capital
        "
    }
    
    codigoOrigemReceita: string [1]
    descricaoOrigemReceita: string [1]
}

kind EspecieReceita {
    label {
        @pt-br "Espécie da Receita"
    }
    description {
        @pt-br "É o nível de classificação vinculado à Origem que permite qualificar com maior detalhe o fato gerador dos ingressos das receitas. Por exemplo, dentro da Origem Receita Tributária, podemos identificar as espécies “impostos, taxas e contribuições de melhoria"
    }
    
    codigoEspecieReceita: number [1]
    descricaoEspecieReceita: string [1]
}

kind RubricaReceita {
    label {
        @pt-br "Rubrica da Receita"
    }
    description {
        @pt-br "É o detalhamento das espécies de receita. A Rubrica busca identificar dentro de cada Espécie de receita, uma qualificação mais específica. Agrega determinadas receitas com características próprias e semelhantes entre si."
    }
    
    codigoRubricaReceita: number [1]
    descricaoRubricaReceita: string [1]
}

kind AlineaReceita {
    label {
        @pt-br "Alínea da Receita"
    }
    description {
        @pt-br "É o detalhamento que identifica o nome da receita propriamente dita, registrando a entrada de recursos financeiros."
    }
    
    codigoAlineaReceita: number [1]
    descricaoAlineaReceita: string [1]
}

kind SubAlineaReceita {
    label {
        @pt-br "Sub-Alínea da Receita"
    }
    description {
        @pt-br "Constitui o nível mais analítico da receita, utilizado quando há necessidade de se detalhar a Alínea com maior especificidade"
    }
    
    codigoSubAlineaReceita: number [1]
    descricaoSubAlineaReceita: string [1]
}

kind idUsoReceita {
    label {
        @pt-br "Identificador de Uso da Receita"
    }
    description {
        @pt-br "Identificador de despesa que indica se os recursos compõem contrapartida nacional de empréstimos ou de doações, ou se são destinados a outras aplicações, constando da LOA e dos créditos adicionais"
    }
    
    codigoIdUsoReceita: number [1]
    descricaoIdUsoReceita: string [1]
}

kind FonteReceita {
    label {
        @pt-br "Fonte de Recurso da Receita"
    }
    description {
        @pt-br "Indica a origem ou procedência do dinheiro arrecadado. Esta classificação combina o critério origem do dinheiro às despesas orçamentárias. Esta vinculação visa demonstrar o montante de dinheiro que já está comprometido com o atendimento de determinadas finalidades, e aquele que pode ser livremente alocado"
    }
    
    codigoFonteReceita: number [1]
    descricaoFonteReceita: string [1]
}

kind GrupoFonteReceita {
    label {
        @pt-br "Grupo de Fonte da Receita"
    }
    description {
        @pt-br "Classificação criada para assegurar que receitas vinculadas por lei a finalidade específica sejam exclusivamente aplicadas em programas e ações que visem à consecução desse objetivo"
    }
    
    codigoGrupoFonteReceita: number [1]
    descricaoGrupoFonteReceita: string [1]
}

kind DetalhamentoFonteReceita {
    label {
        @pt-br "Detalhamento de Fonte da Receita"
    }
    description {
        @pt-br "Código e título do detalhamento da fonte, utilizados no SIGEFES para registrar a receita."
    }
    
    codigoDetalhamentoFonteReceita: number [1]
    codigoDetalhamentoFonteReceitaAux: string [1]
    descricaoDetalhamentoFonteReceita: number [1]
}

/**

ValorPrevista text Valor de arrecadação prevista pelo Governo
ValorArrecadada numeric Valor efetivamente arrecadado pelo Governo
DataEmissao text Data de emissão do documento fiscal
DataContabilizacao numeric Data de contabilização do documento fiscal
Documento text Número do documento fiscal
CodigoUGEmitente numeric Código da Unidade Gestora emitente do documento
DescricaoUGEmitente text Unidade Gestora emitente do documento
Tipo numeric Tipo da receita (previsto ou realizad
id text Código interno de sistema
Ano numeric Ano que foi efetivada a receita
*/
kind ReceitaReificada {
    label {
        @pt-br ""
    }
    description {
        @pt-br ""
    }
    
    valorPrevistoReceita: string [1]
    valorArrecadadoReceita: number [1]
    dataEmissaoReceita: string [1]
    dataContabilizacaoReceita: number [1]
    documentoReceita: string [1]
    codigoUGEmitenteReceita: number [1]
    descricaoUGEmitenteReceita: string [1]
    tipoReceita: number [1]
    idReceita: string [1]
    anoReceita: number [1]
}