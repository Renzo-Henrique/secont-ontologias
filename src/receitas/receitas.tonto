import nucleo

/**
 *
 **** Atributos encontrados apenas nos csv's:
 * tipoLancamentoReceita 
 */

package receitas


datatype CodigoCategoriaEconomicaReceita specializes string
datatype CodigoOrigemReceita specializes string
datatype CodigoEspecieReceita specializes string
datatype CodigoRubricaReceita specializes string
datatype CodigoAlineaReceita specializes string
datatype CodigoSubalineaReceita specializes string
datatype CodigoDetalhamento1Receita specializes string
datatype CodigoDetalhamento2Receita specializes string
datatype CodigoDetalhamento3Receita specializes string
datatype CodigoNaturezaReceita specializes string


mode ClassificacaoReceita2022 {
    label {
        @pt-br "Classificação da Receita"
    }
    description {
        @pt-br "Classificação da Receita"
    }
    /*
    “a.b.c.d.ee.f.g”
    I. “a” corresponde à Categoria Econômica da receita;
    II. “b” corresponde à Origem da receita;
    III. “c” corresponde à Espécie da receita;
    IV. “d”, “ee” e “f” correspondem a desdobramentos que identificam peculiaridades ou
    necessidades gerenciais de cada natureza de receita, sendo que os desdobramentos “ee”,
    correspondentes aos 5º e 6º dígitos da codificação, separam os códigos da União daqueles
    específicos dos demais entes federados, de acordo com a seguinte estrutura lógica:
        a. “00” até “49” identificam códigos reservados para a União, que poderão ser utilizados,
        no que couber, por Estados, Distrito Federal e Municípios;
        b. “50” até “98” identificam códigos reservados para uso específico de Estados, Distrito
        Federal e Municípios; e
        c. “99” será utilizado para registrar “outras receitas”, entendidas assim as receitas
        genéricas que não tenham código identificador específico, atendidas as normas
        contábeis aplicáveis; e
    V. “g” identifica o Tipo de Receita.

    */
    // 
    codigoCategoriaEconomica: CodigoCategoriaEconomicaReceita [1] {const}
    descricaoCategoriaEconomica: string [1] {const}
    // 
    codigoOrigem: CodigoOrigemReceita [1] {const}
    descricaoOrigem: string [1] {const}
    // 
    codigoEspecie: CodigoEspecieReceita [1] {const}
    descricaoEspecie: string [1] {const}
    // 
    codigoRubrica: CodigoRubricaReceita [1] {const}
    descricaoRubrica: string [1] {const}
    // 
    codigoAlinea: CodigoAlineaReceita [1] {const}
    descricaoAlinea: string [1] {const}
    // 
    codigoSubalinea: CodigoSubalineaReceita [1] {const}
    descricaoSubalinea: string [1] {const}
    // 
    codigoDetalhamento1: CodigoDetalhamento1Receita [1] {const}
    descricaoDetalhamento1: string [1] {const}
    // 
    codigoDetalhamento2: CodigoDetalhamento2Receita [1] {const}
    descricaoDetalhamento2: string [1] {const}
    // 
    codigoDetalhamento3: CodigoDetalhamento3Receita [1] {const}
    descricaoDetalhamento3: string [1] {const}
    //
    codigoNatureza: CodigoNaturezaReceita [1] {const}
    descricaoNatureza: string [1] {const}

}

datatype CodigoContaContabilReceita specializes string

mode ContaContabilReceita {
    label {
        @pt-br "Conta Contábil"
    }
    description {
        @pt-br "Conta Contábil"
    }
    codigo: CodigoContaContabilReceita [1] {const}
    descricao: string [1] {const}
}

datatype CodigoUsoReceita specializes string
mode UsoReceita {
    label {
        @pt-br "Uso da Receita"
    }
    description {
        @pt-br "Uso da Receita"
    }
    codigo: CodigoUsoReceita [1] {const}
    descricao: string [1] {const}
}

datatype CodigoFonteReceita specializes string
mode FonteReceita {
    label {
        @pt-br "Fonte da Receita"
    }
    description {
        @pt-br "Fonte da Receita"
    }
    codigo: CodigoFonteReceita [1] {const}
    descricao: string [1] {const}
}

datatype CodigoGrupoFonteReceita specializes string
mode GrupoFonteReceita {
    label {
        @pt-br "Grupo da Fonte da Receita"
    }
    description {
        @pt-br "Grupo da Fonte da Receita"
    }
    codigo: CodigoGrupoFonteReceita [1] {const}
    descricao: string [1] {const}
}

datatype CodigoDetalhamentoFonteReceita specializes string
datatype CodigoDetalhamentoFonteAuxiliarReceita specializes string
mode DetalhamentoFonteReceita {
    label {
        @pt-br "Detalhamento da Fonte da Receita"
    }
    description {
        @pt-br "Detalhamento da Fonte da Receita"
    }
    codigo: CodigoDetalhamentoFonteReceita [1] {const}
    codigoAuxiliar: CodigoDetalhamentoFonteAuxiliarReceita [1] {const}
    descricao: string [1] {const}
}


/**

ValorPrevista text Valor de arrecadação prevista pelo Governo
ValorArrecadada numeric Valor efetivamente arrecadado pelo Governo
DataEmissao text Data de emissão do documento fiscal
DataContabilizacao numeric Data de contabilização do documento fiscal
Documento text Número do documento fiscal
CodigoUGEmitente numeric Código da Unidade Gestora emitente do documento
DescricaoUGEmitente text Unidade Gestora emitente do documento
Tipo numeric Tipo da receita (previsto ou realizad
id text Código interno de sistema
Ano numeric Ano que foi efetivada a receita
*/

datatype IdentificadorReceita specializes string
datatype TipoArquivoReceita specializes string
datatype TipoLancamentoReceita specializes string
datatype IdentificadorReceita specializes string
datatype IdentificadorDocumentoReceita specializes string

relator ReceitaReificada {
    label {
        @pt-br "Receita Reificada"
    }
    description {
        @pt-br "Entidade que representa a receita reificada, com todos os seus atributos e relacionamentos. Reificar significa transformar um conceito em um objeto explícito, ou seja, a receita é transformada em uma entidade com atributos e relacionamentos próprios."
    }
    
    ano: number [1] {const}
    arrecadadaBruta: number [1] {const}
    arrecadadaDeducao: number [1] {const}
    arrecadadaLiquida: number [1] {const}
    // Incluir UTC -3
    data: datetime [1] {const}
    // Incluir UTC -3
    dataContabilizacao: datetime [1] {const}
    // Incluir UTC -3
    dataEmissao: datetime [1] {const}
    documento: IdentificadorDocumentoReceita [1] {const}
    identificador: IdentificadorReceita [1] {const}
    // numeros de 01 a 12, representando os meses do ano
    mes: number [1] {const}
    previstaBruta: number [1] {const}
    previstaDeducao: number [1] {const}
    previstaLiquida: number [1] {const}
    previsto: number [1] {const}
    realizado: number [1] {const}
    recolhidaBruta: number [1] {const}
    recolhido: number [1] {const}
    tipoArquivo: TipoArquivoReceita [1] {const}
    tipoLancamento: TipoLancamentoReceita [1] {const}

}

role UnidadeGestoraEmitenteDaReceita specializes nucleo.UnidadeGestora {
    label {
        @pt-br "Unidade Gestora Emitente da Receita"
    }
    description {
        @pt-br "Unidade Gestora Emitente da Receita"
    }
    
}

role UnidadeGestoraBeneficiariaDaReceita specializes nucleo.UnidadeGestora {
    label {
        @pt-br "Unidade Gestora Beneficiária da Receita"
    }
    description {
        @pt-br "Unidade Gestora Beneficiária da Receita"
    }
    
}


// Relacionamentos

@mediation relation ReceitaReificada [0..*] -- emitidaPara -- [1] UnidadeGestoraBeneficiariaDaReceita
@mediation relation ReceitaReificada [0..*] -- emitidaPor -- [1] UnidadeGestoraEmitenteDaReceita
@mediation relation ReceitaReificada [1] -- naturezaClassificadaPor -- [1] ClassificacaoReceita2022
@mediation relation ReceitaReificada [0..*] -- extraidaDaConta -- [1] contaContabilReceita
@mediation relation ReceitaReificada [0..*] -- usoEspecificadoPor -- [1] UsoReceita
@mediation relation ReceitaReificada [0..*] -- fonteDoDinheiroClassificadoPor -- [1] FonteReceita
@mediation relation ReceitaReificada [0..*] -- detalhamentoRegistradoPor -- [1] DetalhamentoFonteReceita


