    rdfs:label "ClassificadorDeOrcamentoDeDespesa.mediatesClassificadorFuncionalDeDespesa" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas-orcamentos-despesa> ;
