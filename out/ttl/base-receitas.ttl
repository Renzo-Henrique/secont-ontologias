base-receitas:ReceitaOrcamentaria a gufo:Kind,
        owl:Class ;
    rdfs:label "ReceitaOrcamentaria" ;
    rdfs:comment """O orçamento é um importante instrumento de planejamento de qualquer entidade, seja pública ou privada, e representa o fluxo previsto de ingressos e de aplicações de recursos em determinado período.
Cite MCASP - 11º Edicao: Parte I: Seção 3.1
São disponibilidades de recursos financeiros que ingressam durante o exercício e que aumentam o saldo financeiro da instituição. Instrumento por meio do qual se viabiliza a execução das políticas públicas, as receitas orçamentárias são fontes de recursos utilizadas pelo Estado em programas e ações cuja finalidade precípua é atender às necessidades públicas e demandas da sociedade.
Essas receitas pertencem ao Estado, transitam pelo patrimônio do Poder Público e, via de regra, por força do princípio orçamentário da universalidade, estão previstas na Lei Orçamentária Anual - LOA.
Cite MCASP - 11º Edicao: Parte I: Seção 3.1.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-receitas:ReceitaOrcamentariaRegistrada.emitidaPara a gufo:MaterialRelationshipType,
        owl:ObjectProperty ;
    rdfs:label "emitidaPara" ;
    gufo:isDerivedFrom base-receitas:RegistroDeReceitaOrcamentaria ;
    rdfs:domain base-receitas:ReceitaOrcamentariaRegistrada ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:range base-receitas:UnidadeGestoraBeneficiadaDeReceita ;
    owl:propertyChainAxiom ( [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temReceitaOrcamentaria ] base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiadaDeReceita ) .

base-receitas:ReceitaOrcamentariaRegistrada.emitidaPor a gufo:MaterialRelationshipType,
        owl:ObjectProperty ;
    rdfs:label "emitidaPor" ;
    gufo:isDerivedFrom base-receitas:RegistroDeReceitaOrcamentaria ;
    rdfs:domain base-receitas:ReceitaOrcamentariaRegistrada ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:range base-receitas:UnidadeGestoraEmitenteDeReceita ;
    owl:propertyChainAxiom ( [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temReceitaOrcamentaria ] base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitenteDeReceita ) .

base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiadaDeReceita a owl:ObjectProperty ;
    rdfs:label "temUnidadeGestoraBeneficiadaDeReceita" ;
    rdfs:domain base-receitas:RegistroDeReceitaOrcamentaria ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:range base-receitas:UnidadeGestoraBeneficiadaDeReceita ;
    rdfs:subPropertyOf gufo:mediates .

base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitenteDeReceita a owl:ObjectProperty ;
    rdfs:label "temUnidadeGestoraEmitenteDeReceita" ;
    rdfs:domain base-receitas:RegistroDeReceitaOrcamentaria ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:range base-receitas:UnidadeGestoraEmitenteDeReceita ;
    rdfs:subPropertyOf gufo:mediates .

base-receitas:ContaContabil a gufo:Category,
        owl:Class ;
    rdfs:label "ContaContabil" ;
    rdfs:comment """Conta é a expressão qualitativa e quantitativa de fatos de mesma natureza, que evidencia a composição, variação e estado do patrimônio, bem como de bens, direitos, obrigações e situações nele não compreendidas, mas que, direta ou indiretamente, possam vir a afetá-lo.
Cite MCASP - 11º Edicao: Parte IV: Seções 2.3 ;"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ContaContabil.codigo ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ContaContabil.descricao ],
        gufo:FunctionalComplex .

base-receitas:RegistroDeReceitaOrcamentaria.temReceitaOrcamentaria a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temReceitaOrcamentaria" ;
    rdfs:domain base-receitas:RegistroDeReceitaOrcamentaria ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:range base-receitas:ReceitaOrcamentariaRegistrada ;
    rdfs:subPropertyOf gufo:mediates .

base-receitas:UnidadeGestoraBeneficiadaDeReceita a gufo:Role,
        owl:Class ;
    rdfs:label "UnidadeGestoraBeneficiadaDeReceita" ;
    rdfs:comment "Unidade gestora beneficiada por uma receita orçamentária emitida."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiadaDeReceita ] ;
            owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:ReceitaOrcamentariaRegistrada.emitidaPara ] ;
            owl:someValuesFrom base-receitas:ReceitaOrcamentariaRegistrada ],
        nucleo:UnidadeGestora .

base-receitas:UnidadeGestoraEmitenteDeReceita a gufo:Role,
        owl:Class ;
    rdfs:label "UnidadeGestoraEmitenteDeReceita" ;
    rdfs:comment "Unidade gestora responsável pela emissão da receita orçamentária."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitenteDeReceita ] ;
            owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:ReceitaOrcamentariaRegistrada.emitidaPor ] ;
            owl:someValuesFrom base-receitas:ReceitaOrcamentariaRegistrada ],
        nucleo:UnidadeGestora .

base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria a gufo:Kind,
        owl:Class ;
    rdfs:label "ClassificacaoDoRegistroDeReceitaOrcamentaria" ;
    rdfs:comment "Relator que associa a Receita às classificações de natureza, fonte e conta contábil."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass base-receitas:RegistroDeReceitaOrcamentaria ;
            owl:onProperty base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.classifica ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass base-receitas:NaturezaDaReceita ;
            owl:onProperty base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.naturezaClassificadaPor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass base-receitas:FonteDaReceita ;
            owl:onProperty base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.fonteClassificadaPor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass base-receitas:ContaContabil ;
            owl:onProperty base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.contabilClassificadaPor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

base-receitas:FonteDaReceita a gufo:RoleMixin,
        owl:Class ;
    rdfs:label "FonteDaReceita" ;
    rdfs:comment """No momento da arrecadação, a FR deverá ser informada no registro da realização da receita orçamentária (classe 6 do PCASP), no registro do ingresso dos recursos financeiros no ativo financeiro (classe 1 com atributo "F") e em contas de controle da Disponibilidade por Destinação de Recursos - DDR (nas classes 7 e 8 do PCASP). A partir desse momento, a FR informada para os recursos financeiros não deverá ser alterada
Cite MCASP - 11º Edicao: Parte I: Seção 5.2""" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.codigoFonte ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.descricaoFonte ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.codigoGrupoFonte ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.descricaoGrupoFonte ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.codigoDetalhamentoFonte ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.codigoDetalhamentoFonteAux ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:FonteDaReceita.descricaoDetalhamentoFonte ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.fonteClassificadaPor ] ;
            owl:someValuesFrom base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria ],
        nucleo:FonteOrcamentaria .

base-receitas:ReceitaOrcamentariaRegistrada a gufo:Role,
        owl:Class ;
    rdfs:label "ReceitaOrcamentariaRegistrada" ;
    rdfs:comment "Receita orçamentária registrada emitida por uma unidade gestora e beneficiando outra unidade gestora."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ReceitaOrcamentariaRegistrada.dataEmissao ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ReceitaOrcamentariaRegistrada.documento ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ReceitaOrcamentariaRegistrada.ano ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temReceitaOrcamentaria ] ;
            owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
            owl:onProperty base-receitas:ReceitaOrcamentariaRegistrada.emitidaPara ;
            owl:someValuesFrom base-receitas:UnidadeGestoraBeneficiadaDeReceita ],
        [ a owl:Restriction ;
            owl:onProperty base-receitas:ReceitaOrcamentariaRegistrada.emitidaPor ;
            owl:someValuesFrom base-receitas:UnidadeGestoraEmitenteDeReceita ],
        base-receitas:ReceitaOrcamentaria .

base-receitas:ValorAtreladoNaReceita a gufo:AbstractIndividualType,
        owl:Class ;
    rdfs:label "ValorAtreladoNaReceita" ;
    rdfs:comment "Tipo de dados que agrupa os valores monetários que um Registro de Receita Orçamentária pode ter."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorPrevista ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorArrecadada ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorRecolhida ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorPrevistaBruta ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorPrevistaDeducao ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorPrevistaLiquida ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorArrecadadaBruta ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorArrecadadaDeducao ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorArrecadadaLiquida ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:ValorAtreladoNaReceita.valorRecolhidaBruta ],
        gufo:QualityValue .

base-receitas:RegistroDeReceitaOrcamentaria a gufo:Kind,
        owl:Class ;
    rdfs:label "RegistroDeReceitaOrcamentaria" ;
    rdfs:comment "Registro que associa a Receita às unidades gestoras emitentes e beneficiadas."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.valorAtreladoNaReceita ;
            owl:someValuesFrom base-receitas:ValorAtreladoNaReceita ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.codigoIdUso ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.descricaoIdUso ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.tipoLancamento ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.dataContabilizacao ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.tipo ],
        [ a owl:Restriction ;
            owl:onClass base-receitas:ReceitaOrcamentariaRegistrada ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.temReceitaOrcamentaria ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitenteDeReceita ;
            owl:someValuesFrom base-receitas:UnidadeGestoraEmitenteDeReceita ],
        [ a owl:Restriction ;
            owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiadaDeReceita ;
            owl:someValuesFrom base-receitas:UnidadeGestoraBeneficiadaDeReceita ],
        [ a owl:Restriction ;
            owl:onClass base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria ;
            owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria.classifica ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

base-receitas:NaturezaDaReceita a gufo:Category,
        owl:Class ;
    rdfs:label "NaturezaDaReceita" ;
    rdfs:comment """O § 1º do art. 8º da Lei nº 4.320/1964 define que os itens da discriminação da receita, mencionados no art. 11 dessa lei, serão identificados por números de código decimal. Convencionou-se denominar este código de natureza de receita.
Importante destacar que a classificação da receita orçamentária por natureza é utilizada por todos os entes da Federação e visa identificar a origem do recurso segundo o fato gerador: acontecimento real que ocasionou o ingresso da receita nos cofres públicos.
A classificação por Natureza de Receita Orçamentária é composta por um código de oito dígitos numéricos que representam: a Categoria Econômica, a Origem, a Espécie, os Desdobramentos e o Tipo de Receita.
Cite MCASP - 11º Edicao: Parte I: Seção 3.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoNatureza ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento1 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento2 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento3 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoTipo ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoTipo ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoNatureza ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoCategoria ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoCategoria ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoOrigem ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoOrigem ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoEspecie ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.descricaoEspecie ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento1 ],
        gufo:FunctionalComplex .

[] a owl:AllDisjointClasses ;
    owl:members ( base-receitas:ClassificacaoDoRegistroDeReceitaOrcamentaria base-receitas:ReceitaOrcamentaria base-receitas:RegistroDeReceitaOrcamentaria ) .

