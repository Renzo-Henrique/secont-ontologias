# Written by `tonto gufo` from the tonto ontology base-receitas.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix base-receitas: <https://example.org/ontologia-portal-transparencia-es/base-receitas#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/base-receitas> a owl:Ontology ;
    owl:imports
        <http://purl.org/nemo/gufo#>,
        <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    vann:preferredNamespacePrefix "base-receitas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-receitas#" .

base-receitas:NaturezaDaReceita a owl:Class, gufo:Category ;
    rdfs:label "NaturezaDaReceita" ;
    rdfs:comment """O § 1º do art. 8º da Lei nº 4.320/1964 define que os itens da discriminação da receita, mencionados no art. 11 dessa lei, serão identificados por números de código decimal. Convencionou-se denominar este código de natureza de receita.
Importante destacar que a classificação da receita orçamentária por natureza é utilizada por todos os entes da Federação e visa identificar a origem do recurso segundo o fato gerador: acontecimento real que ocasionou o ingresso da receita nos cofres públicos.
A classificação por Natureza de Receita Orçamentária é composta por um código de oito dígitos numéricos que representam: a Categoria Econômica, a Origem, a Espécie, os Desdobramentos e o Tipo de Receita.
Cite MCASP - 11º Edicao: Parte I: Seção 3.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoNatureza ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoNatureza ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoCategoria ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoCategoria ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoOrigem ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoOrigem ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoEspecie ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoEspecie ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento1 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento1 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento2 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento2 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoDetalhamento3 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoDetalhamento3 ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.codigoTipo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:NaturezaDaReceita.descricaoTipo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDeReceitaOrcamentaria.NaturezaClassificadaPor ] ;
          owl:someValuesFrom base-receitas:ClassificacaoDeReceitaOrcamentaria ] .

base-receitas:FonteDaReceita a owl:Class, gufo:Category ;
    rdfs:label "FonteDaReceita" ;
    rdfs:comment """A classificação por fontes ou destinações de recursos (FR) tem como objetivo agrupar receitas que possuam as mesmas normas de aplicação na despesa. Em regra, as fontes ou destinações de recursos reúnem recursos oriundos de determinados códigos da classificação por natureza da receita orçamentária, conforme regras previamente estabelecidas. Por meio do orçamento público, essas fontes ou destinações são associadas a determinadas despesas de forma a evidenciar os meios para atingir os objetivos públicos.
Cite MCASP - 11º Edicao: Parte I: Seção 5.1
No momento da arrecadação, a FR deverá ser informada no registro da realização da receita orçamentária (classe 6 do PCASP), no registro do ingresso dos recursos financeiros no ativo financeiro (classe 1 com atributo \"F\") e em contas de controle da Disponibilidade por Destinação de Recursos - DDR (nas classes 7 e 8 do PCASP). A partir desse momento, a FR informada para os recursos financeiros não deverá ser alterada
Cite MCASP - 11º Edicao: Parte I: Seção 5.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.codigoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.descricaoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.codigoGrupoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.descricaoGrupoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.codigoDetalhamentoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.codigoDetalhamentoFonteAux ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:FonteDaReceita.descricaoDetalhamentoFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDeReceitaOrcamentaria.FonteClassificadaPor ] ;
          owl:someValuesFrom base-receitas:ClassificacaoDeReceitaOrcamentaria ] .

base-receitas:ContaContabil a owl:Class, gufo:Category ;
    rdfs:label "ContaContabil" ;
    rdfs:comment """Conta é a expressão qualitativa e quantitativa de fatos de mesma natureza, que evidencia a composição, variação e estado do patrimônio, bem como de bens, direitos, obrigações e situações nele não compreendidas, mas que, direta ou indiretamente, possam vir a afetá-lo.
Cite MCASP - 11º Edicao: Parte IV: Seções 2.3 ; 3.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ContaContabil.codigo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ContaContabil.descricao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDeReceitaOrcamentaria.InformacaoContabilClassificadaPor ] ;
          owl:someValuesFrom base-receitas:ClassificacaoDeReceitaOrcamentaria ] .

base-receitas:UnidadeGestoraEmitenteDeReceita a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraEmitenteDeReceita" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitente ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPor ] ;
          owl:someValuesFrom base-receitas:DocumentoContabilDeReceitaOrcamentaria ] .

base-receitas:UnidadeGestoraBeneficiadaDeReceita a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraBeneficiadaDeReceita" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiada ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPara ] ;
          owl:someValuesFrom base-receitas:DocumentoContabilDeReceitaOrcamentaria ] .

base-receitas:DocumentoContabilDeReceitaOrcamentaria a owl:Class, gufo:Role ;
    rdfs:label "DocumentoContabilDeReceitaOrcamentaria" ;
    rdfs:comment """O orçamento é um importante instrumento de planejamento de qualquer entidade, seja pública ou privada, e representa o fluxo previsto de ingressos e de aplicações de recursos em determinado período.
Cite MCASP - 11º Edicao: Parte I: Seção 3.1
São disponibilidades de recursos financeiros que ingressam durante o exercício e que aumentam o saldo financeiro da instituição. Instrumento por meio do qual se viabiliza a execução das políticas públicas, as receitas orçamentárias são fontes de recursos utilizadas pelo Estado em programas e ações cuja finalidade precípua é atender às necessidades públicas e demandas da sociedade.
Essas receitas pertencem ao Estado, transitam pelo patrimônio do Poder Público e, via de regra, por força do princípio orçamentário da universalidade, estão previstas na Lei Orçamentária Anual - LOA.
Cite MCASP - 11º Edicao: Parte I: Seção 3.1.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        nucleo:DocumentoContabil,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.codigoIdUso ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.descricaoIdUso ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevista ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadada ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorRecolhida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.tipoLancamento ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.dataEmissao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.dataContabilizacao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.documento ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.tipo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorPrevistaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorArrecadadaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.valorRecolhidaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.ano ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:RegistroDeReceitaOrcamentaria.formalizadaPor ] ;
          owl:someValuesFrom base-receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-receitas:ClassificacaoDeReceitaOrcamentaria.ClassificadorDocumentalDe ] ;
          owl:someValuesFrom base-receitas:ClassificacaoDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPor ;
          owl:someValuesFrom base-receitas:UnidadeGestoraEmitenteDeReceita ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:DocumentoContabilDeReceitaOrcamentaria.emitidaPara ;
          owl:someValuesFrom base-receitas:UnidadeGestoraBeneficiadaDeReceita ] .

base-receitas:RegistroDeReceitaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeReceitaOrcamentaria" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.formalizadaPor ;
          owl:onClass base-receitas:DocumentoContabilDeReceitaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitente ;
          owl:onClass base-receitas:UnidadeGestoraEmitenteDeReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiada ;
          owl:onClass base-receitas:UnidadeGestoraBeneficiadaDeReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-receitas:ClassificacaoDeReceitaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "ClassificacaoDeReceitaOrcamentaria" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-receitas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ClassificacaoDeReceitaOrcamentaria.NaturezaClassificadaPor ;
          owl:onClass base-receitas:NaturezaDaReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ClassificacaoDeReceitaOrcamentaria.FonteClassificadaPor ;
          owl:onClass base-receitas:FonteDaReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ClassificacaoDeReceitaOrcamentaria.InformacaoContabilClassificadaPor ;
          owl:onClass base-receitas:ContaContabil ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-receitas:ClassificacaoDeReceitaOrcamentaria.ClassificadorDocumentalDe ;
          owl:onClass base-receitas:DocumentoContabilDeReceitaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

