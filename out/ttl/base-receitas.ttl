@prefix base-receitas: <https://example.org/ontologia-portal-transparencia-es/base-receitas#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/ontologia-portal-transparencia-es/base-receitas> a owl:Ontology ;
    rdfs:label "OPTES:base-receitas"@pt-br ;
    dcterms:creator "César Bernabé",
        "Fábio Cipriano Soave",
        "Miguel Gewer de Oliveira",
        "Renzo H. Guzzo Leão",
        "Veruska Zamborlini",
        "Vítor E. Silva Souza" ;
    dcterms:description "Concentra os requisitos gerais relacionados às receitas públicas representadas no conjunto de dados analisado. Seu objetivo é estabelecer os conceitos centrais necessárias para compreender o que está sendo representado como receita e como essas informações se relacionam com elementos administrativos presentes na base, especialmente as Unidades Gestoras. O módulo contempla conceitos relacionados às receitas orçamentárias, aos registros de receitas e às classificações utilizadas para caracterizar as receitas, bem como aos diferentes papéis desempenhados pelas unidades gestoras. Nesse contexto, o conceito Receita Orçamentária é uma entidade própria que são disponibilidades de recursos financeiros que ingressam durante o exercício e que aumentam o saldo financeiro de uma Unidade Gestora."@pt-br ;
    dcterms:title "Ontologia do Portal da Transparência do ES (OPTES) - Módulo base-receitas"@pt-br ;
    vann:preferredNamespacePrefix "base-receitas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-receitas#" ;
    rdfs:comment "Concentra os requisitos gerais relacionados às receitas públicas representadas no conjunto de dados analisado. Seu objetivo é estabelecer os conceitos centrais necessárias para compreender o que está sendo representado como receita e como essas informações se relacionam com elementos administrativos presentes na base, especialmente as Unidades Gestoras. O módulo contempla conceitos relacionados às receitas orçamentárias, aos registros de receitas e às classificações utilizadas para caracterizar as receitas, bem como aos diferentes papéis desempenhados pelas unidades gestoras. Nesse contexto, o conceito Receita Orçamentária é uma entidade própria que são disponibilidades de recursos financeiros que ingressam durante o exercício e que aumentam o saldo financeiro de uma Unidade Gestora."@pt-br ;
    owl:imports gufo:, <https://example.org/ontologia-portal-transparencia-es/nucleo> .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

