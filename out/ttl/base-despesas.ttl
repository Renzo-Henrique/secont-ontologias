[] a owl:AllDisjointClasses ;
    owl:members (
        base-despesas:ClassificadorDeDespesaOrcamentaria
        base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria
        base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria
        base-despesas:RegistroDeDespesaOrcamentaria
    ) .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .
