# Written by `tonto gufo` from the tonto ontology base-despesas.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix base-despesas: <https://example.org/ontologia-portal-transparencia-es/base-despesas#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/base-despesas> a owl:Ontology ;
    owl:imports
        <http://purl.org/nemo/gufo#>,
        <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    vann:preferredNamespacePrefix "base-despesas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-despesas#" .

base-despesas:DocumentoContabilDeDespesaOrcamentaria a owl:Class, gufo:SubKind ;
    rdfs:label "DocumentoContabilDeDespesaOrcamentaria" ;
    rdfs:comment """Despesa orçamentária é toda transação que depende de autorização legislativa, na forma de consignação de dotação orçamentária, para ser efetivada.
Cite MCASP - 11º Edição: Parte I: Seção 4.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf nucleo:DocumentoContabil ;
    owl:equivalentClass [ a owl:Class ;
                          owl:unionOf (
                              base-despesas:DespesaDeExercicioAnterior
                              base-despesas:DespesaDeExercicioVigente
                          ) ] .

base-despesas:ClassificadorInstitucionalDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorInstitucionalDeDespesa" ;
    rdfs:comment """A classificação institucional reflete a estrutura de alocação dos créditos orçamentários e está estruturada em dois níveis hierárquicos: órgão orçamentário e unidade orçamentária. Constitui unidade orçamentária o agrupamento de serviços subordinados ao mesmo órgão ou repartição a que serão consignadas dotações próprias (art. 14 da Lei nº 4.320/1964).
Cite MCASP - 11º Edição: Parte I: Seção 4.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:IntrinsicMode,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorInstitucionalDeDespesa.inheresInDocumentoContabilDeDespesaOrcamentaria ;
          owl:onClass base-despesas:DocumentoContabilDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorFuncionalDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorFuncionalDeDespesa" ;
    rdfs:comment """A classificação funcional segrega as dotações orçamentárias em funções e subfunções, buscando responder basicamente à indagação \"em que área\" de ação governamental a despesa será realizada. A atual classificação funcional foi instituída pela Portaria nº 42/1999, do então Ministério do Orçamento e Gestão, divulgada pela Portaria SOF/ME nº 2.520/2022, e é composta de um rol de funções e subfunções prefixadas, que servem como agregador dos gastos públicos por área de ação governamental nas três esferas de Governo. Trata-se de uma classificação independente dos programas e de aplicação comum e obrigatória, no âmbito da União, dos Estados, do Distrito Federal e dos Municípios, o que permite a consolidação nacional dos gastos do setor público.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:IntrinsicMode,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorFuncionalDeDespesa.inheresInDocumentoContabilDeDespesaOrcamentaria ;
          owl:onClass base-despesas:DocumentoContabilDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorEstruturaProgramaticaDeDespesa" ;
    rdfs:comment """Toda ação do Governo está estruturada em programas orientados para a realização dos objetivos estratégicos definidos no Plano Plurianual (PPA) para o período de quatro anos. Conforme estabelecido no art. 3º da Portaria SOF/SETO/ME nº 42/1999 (divulgada pela Portaria SOF/ME nº 2.520/2022), a União, os Estados, o Distrito Federal e os Municípios estabelecerão, em atos próprios, suas estruturas de programas, códigos e identificação, respeitados os conceitos e determinações nela contidos. Ou seja, todos os entes devem ter seus trabalhos organizados por programas e ações, mas cada um estabelecerá seus próprios programas e ações de acordo com a referida Portaria
Cite MCASP - 11º Edição: Parte I: Seção 4.2.3
Na União, o subtítulo representa o menor nível de categoria de programação e será detalhado por esfera orçamentária (fiscal, seguridade e investimento), grupo de natureza de despesa, modalidade de aplicação, identificador de resultado primário, identificador de uso e fonte de recursos, sendo o produto e a unidade de medida os mesmos da ação orçamentária.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.3.3"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:IntrinsicMode,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.inheresInDocumentoContabilDeDespesaOrcamentaria ;
          owl:onClass base-despesas:DocumentoContabilDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorPorNaturezaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorNaturezaDeDespesa" ;
    rdfs:comment """A classificação da despesa orçamentária, segundo a sua natureza, compõe-se de: a. Categoria Econômica ; b. Grupo de Natureza da Despesa ; c. Elemento de Despesa.  A natureza da despesa será complementada pela informação gerencial denominada \"Modalidade de Aplicação\", a qual tem por finalidade indicar se os recursos são aplicados diretamente por órgãos ou entidades no âmbito da mesma esfera de Governo ou por outro ente da Federação e suas respectivas entidades, e objetiva, precipuamente, possibilitar a eliminação da dupla contagem dos recursos transferidos ou descentralizados.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.4"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:IntrinsicMode,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.inheresInDocumentoContabilDeDespesaOrcamentaria ;
          owl:onClass base-despesas:DocumentoContabilDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:FonteDaDespesa a owl:Class, gufo:Category ;
    rdfs:label "FonteDaDespesa" ;
    rdfs:comment """A classificação por fontes ou destinações de recursos (FR) tem como objetivo agrupar receitas que possuam as mesmas normas de aplicação na despesa. Em regra, as fontes ou destinações de recursos reúnem recursos oriundos de determinados códigos da classificação por natureza da receita orçamentária, conforme regras previamente estabelecidas. Por meio do orçamento público, essas fontes ou destinações são associadas a determinadas despesas de forma a evidenciar os meios para atingir os objetivos públicos.
Cite MCASP - 11º Edição: Parte I: Seção 5.1
Na execução orçamentária da despesa, a FR estará associada, desde o momento do empenho, às contas de controle orçamentário (classe 6 do PCASP), às contas do passivo financeiro (classe 2 com atributo “F”) e às contas de controle da disponibilidade por destinação de recursos (na classe 8)
Cite MCASP - 11º Edição: Parte I: Seção 5.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:IntrinsicMode,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:FonteDaDespesa.inheresInDocumentoContabilDeDespesaOrcamentaria ;
          owl:onClass base-despesas:DocumentoContabilDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:DocumentoContabilDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "DocumentoContabilDeDespesa" ;
    rdfs:comment "Documento contabil referente aos arquivos \"Despesas\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaDeExercicioVigente,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.mediatesDocumentoContabilDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] .

base-despesas:UnidadeGestoraEmitenteDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraEmitenteDeDespesa" ;
    rdfs:comment "Unidade gestora responsável pela emissão do documento contábil de despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.mediatesUnidadeGestoraEmitenteDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] .

base-despesas:RegistroDeDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeDespesaOrcamentaria" ;
    rdfs:comment "Registro que associa o documento contábil de despesa à unidade gestora emitente."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.dadosAnonimizados ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.mediatesDocumentoContabilDeDespesa ;
          owl:onClass base-despesas:DocumentoContabilDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.mediatesUnidadeGestoraEmitenteDeDespesa ;
          owl:onClass base-despesas:UnidadeGestoraEmitenteDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ConvenioConcedido a owl:Class, gufo:Role ;
    rdfs:label "ConvenioConcedido" ;
    rdfs:comment "Convênio no qual a unidade gestora concede recursos relacionados à despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria.mediatesConvenioConcedido ] ;
          owl:someValuesFrom base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria ] .

base-despesas:ConvenioRecebido a owl:Class, gufo:Role ;
    rdfs:label "ConvenioRecebido" ;
    rdfs:comment "Convênio no qual a unidade gestora recebe recursos relacionados à despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesConvenioRecebido ] ;
          owl:someValuesFrom base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria ] .

base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeConvenioConcedidoNaDespesaOrcamentaria" ;
    rdfs:comment "Registro da associação entre um convênio concedido e o documento contábil de despesa correspondente."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria.mediatesConvenioConcedido ;
          owl:onClass base-despesas:ConvenioConcedido ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria.mediatesDocumentoContabilDeDespesa ;
          owl:onClass base-despesas:DocumentoContabilDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeConvenioRecebidoNaDespesaOrcamentaria" ;
    rdfs:comment "Registro da associação entre um convênio recebido e o documento contábil de despesa correspondente."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesConvenioRecebido ;
          owl:onClass base-despesas:ConvenioRecebido ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesDocumentoContabilDeDespesa ;
          owl:onClass base-despesas:DocumentoContabilDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:UnidadeGestoraComRestosAPagar a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraComRestosAPagar" ;
    rdfs:comment "Unidade gestora associada ao registro de despesas inscritas em restos a pagar."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeRestosAPagar.mediatesUnidadeGestoraComRestosAPagar ] ;
          owl:someValuesFrom base-despesas:RegistroDeRestosAPagar ] .

base-despesas:DespesaDeExercicioVigente a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioVigente" ;
    rdfs:comment "Despesa empenhada que foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:DespesaDeExercicioAnterior a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioAnterior" ;
    rdfs:comment """São Restos a Pagar todas as despesas regularmente empenhadas, do exercício atual ou anterior, mas não pagas até 31 de dezembro do exercício financeiro vigente.
Cite MCASP - 11º Edição: Parte I: Seção 4.7"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:TerminoDoExercicioDeDespesaVigente a owl:Class, gufo:SituationType ;
    rdfs:label "TerminoDoExercicioDeDespesaVigente" ;
    rdfs:comment """No fim do exercício, as despesas orçamentárias empenhadas e não pagas serão inscritas em restos a pagar.
Cite MCASP - 11º Edição: Parte I: Seção 4.7.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:Situation .

base-despesas:CriacaoDeDespesaNaoPaga a owl:Class, gufo:EventType ;
    rdfs:label "CriacaoDeDespesaNaoPaga" ;
    rdfs:comment "Evento de criação de uma despesa empenhada que NÃO foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Event,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:TerminoDoExercicioDeDespesaVigente.triggers ] ;
          owl:onClass base-despesas:TerminoDoExercicioDeDespesaVigente ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioVigente ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioAnterior ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:DocumentoContabilDeRestosAPagar a owl:Class, gufo:Role ;
    rdfs:label "DocumentoContabilDeRestosAPagar" ;
    rdfs:comment "Documento contabil referente aos arquivos \"RestosAPagar\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaDeExercicioAnterior,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeRestosAPagar.mediatesDocumentoContabilDeRestosAPagar ] ;
          owl:someValuesFrom base-despesas:RegistroDeRestosAPagar ] .

base-despesas:RegistroDeRestosAPagar a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeRestosAPagar" ;
    rdfs:comment "Registro de uma despesa inscrita em restos a pagar e da unidade gestora associada, com dados de anonimização e Poder da Federação."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.dadosAnonimizados ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.poder ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.mediatesDocumentoContabilDeRestosAPagar ;
          owl:onClass base-despesas:DocumentoContabilDeRestosAPagar ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.mediatesUnidadeGestoraComRestosAPagar ;
          owl:onClass base-despesas:UnidadeGestoraComRestosAPagar ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:UnidadeGestoraComOrcamentoDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraComOrcamentoDeDespesa" ;
    rdfs:comment "Unidade gestora associada ao registro de orçamento de despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeDespesa.mediatesUnidadeGestoraComOrcamentoDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeDespesa ] .

base-despesas:DocumentoContabilDeOrcamentoDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "DocumentoContabilDeOrcamentoDeDespesa" ;
    rdfs:comment "Documento contabil referente aos arquivos \"OrcamentosDespesa\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeDespesa.mediatesDocumentoContabilDeOrcamentoDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeDespesa ] .

base-despesas:RegistroDeOrcamentoDeDespesa a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeOrcamentoDeDespesa" ;
    rdfs:comment "Registro do orçamento de despesa, associado à unidade gestora e às localidades geográficas aplicáveis."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesDocumentoContabilDeOrcamentoDeDespesa ;
          owl:onClass base-despesas:DocumentoContabilDeOrcamentoDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesUnidadeGestoraComOrcamentoDeDespesa ;
          owl:onClass base-despesas:UnidadeGestoraComOrcamentoDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMicroRegiao ;
          owl:onClass nucleo:MicroRegiao ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMunicipio ;
          owl:onClass nucleo:Municipio ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:UnidadeGestoraComOrcamentoDeExecucao a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraComOrcamentoDeExecucao" ;
    rdfs:comment "Unidade gestora associada ao registro de execução do orçamento de despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeExecucao.mediatesUnidadeGestoraComOrcamentoDeExecucao ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeExecucao ] .

base-despesas:DocumentoContabilDeOrcamentoDeExecucao a owl:Class, gufo:Role ;
    rdfs:label "DocumentoContabilDeOrcamentoDeExecucao" ;
    rdfs:comment "Documento contabil referente aos arquivos \"OrcamentosExecucoes\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeExecucao.mediatesDocumentoContabilDeOrcamentoDeExecucao ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeExecucao ] .

base-despesas:RegistroDeOrcamentoDeExecucao a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeOrcamentoDeExecucao" ;
    rdfs:comment "Registro da execução do orçamento de despesa, associado ao documento contábil e à unidade gestora."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeExecucao.mediatesDocumentoContabilDeOrcamentoDeExecucao ;
          owl:onClass base-despesas:DocumentoContabilDeOrcamentoDeExecucao ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeExecucao.mediatesUnidadeGestoraComOrcamentoDeExecucao ;
          owl:onClass base-despesas:UnidadeGestoraComOrcamentoDeExecucao ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:AllDisjointClasses ;
    owl:members (
        base-despesas:DespesaDeExercicioAnterior
        base-despesas:DespesaDeExercicioVigente
    ) .

