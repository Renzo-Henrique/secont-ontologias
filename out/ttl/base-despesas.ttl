@prefix base-despesas: <https://example.org/ontologia-portal-transparencia-es/base-despesas#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/ontologia-portal-transparencia-es/base-despesas> a owl:Ontology ;
    rdfs:label "OPTES:base-despesas"@pt-br ;
    dcterms:creator "César Bernabé",
        "Fábio Cipriano Soave",
        "Miguel Gewer de Oliveira",
        "Renzo H. Guzzo Leão",
        "Veruska Zamborlini",
        "Vítor E. Silva Souza" ;
    dcterms:description "Concentra os requisitos gerais relacionados às despesas (execução orçamentária e financeira dos Órgãos e Entidades da Administração Pública Estadual.) representadas no conjunto de dados analisado. Seu objetivo é estabelecer os conceitos centrais necessárias para compreender o que está sendo representado como despesa e como essas informações se relacionam com elementos administrativos presentes na base, especialmente as Unidades Gestoras. O módulo contempla conceitos relacionados às despesas orçamentárias (com seus diferentes tipos), aos registros de despesas (com seus diferentes tipos) e às classificações utilizadas para caracterizar as despesas, bem como a relação com unidades gestoras. Nesse contexto, o conceito Despesa Orçamentária é uma entidade própria que representa um conjunto de dispêndios realizados pelos entes públicos para o funcionamento e manutenção dos serviços públicos prestados à sociedade."@pt-br ;
    dcterms:title "Ontologia do Portal da Transparência do ES (OPTES) - Módulo base-despesas"@pt-br ;
    vann:preferredNamespacePrefix "base-despesas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-despesas#" ;
    rdfs:comment "Concentra os requisitos gerais relacionados às despesas (execução orçamentária e financeira dos Órgãos e Entidades da Administração Pública Estadual.) representadas no conjunto de dados analisado. Seu objetivo é estabelecer os conceitos centrais necessárias para compreender o que está sendo representado como despesa e como essas informações se relacionam com elementos administrativos presentes na base, especialmente as Unidades Gestoras. O módulo contempla conceitos relacionados às despesas orçamentárias (com seus diferentes tipos), aos registros de despesas (com seus diferentes tipos) e às classificações utilizadas para caracterizar as despesas, bem como a relação com unidades gestoras. Nesse contexto, o conceito Despesa Orçamentária é uma entidade própria que representa um conjunto de dispêndios realizados pelos entes públicos para o funcionamento e manutenção dos serviços públicos prestados à sociedade."@pt-br ;
    owl:imports gufo:, <https://example.org/ontologia-portal-transparencia-es/nucleo> .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

