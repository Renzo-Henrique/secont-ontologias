# Written by `tonto gufo` from the tonto ontology base-despesas.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix base-despesas: <https://example.org/ontologia-portal-transparencia-es/base-despesas#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/base-despesas> a owl:Ontology ;
    owl:imports
        <http://purl.org/nemo/gufo#>,
        <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    vann:preferredNamespacePrefix "base-despesas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-despesas#" .

base-despesas:DespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "DespesaOrcamentaria" ;
    rdfs:comment """A despesa orçamentária pública é o conjunto de dispêndios realizados pelos entes públicos para o funcionamento e manutenção dos serviços públicos prestados à sociedade.
Despesa orçamentária é toda transação que depende de autorização legislativa, na forma de consignação de dotação orçamentária, para ser efetivada.
Cite MCASP - 11º Edição: Parte I: Seção 4.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    owl:equivalentClass
        [ a owl:Class ;
          owl:unionOf (
              base-despesas:DespesaDeEmpenho
              base-despesas:DespesaDeLiquidacao
              base-despesas:DespesaDePagamento
          ) ],
        [ a owl:Class ;
          owl:unionOf (
              base-despesas:DespesaDeExercicioAnterior
              base-despesas:DespesaDeExercicioVigente
          ) ] .

base-despesas:ClassificadorInstitucionalDeDespesa a owl:Class, gufo:Kind ;
    rdfs:label "ClassificadorInstitucionalDeDespesa" ;
    rdfs:comment """A classificação institucional reflete a estrutura de alocação dos créditos orçamentários e está estruturada em dois níveis hierárquicos: órgão orçamentário e unidade orçamentária. Constitui unidade orçamentária o agrupamento de serviços subordinados ao mesmo órgão ou repartição a que serão consignadas dotações próprias (art. 14 da Lei nº 4.320/1964).
Cite MCASP - 11º Edição: Parte I: Seção 4.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorInstitucionalDeDespesa.mediatesClassificacaoDoRegistroDeDespesaOrcamentaria ;
          owl:onClass base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorInstitucionalDeDespesa.mediatesOrgaoPublicoOrcamentarioNaDespesa ;
          owl:onClass base-despesas:OrgaoPublicoOrcamentarioNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorInstitucionalDeDespesa.mediatesUnidadeOrcamentariaNaDespesa ;
          owl:onClass base-despesas:UnidadeOrcamentariaNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorFuncionalDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorFuncionalDeDespesa" ;
    rdfs:comment """A classificação funcional segrega as dotações orçamentárias em funções e subfunções, buscando responder basicamente à indagação \"em que área\" de ação governamental a despesa será realizada. A atual classificação funcional foi instituída pela Portaria nº 42/1999, do então Ministério do Orçamento e Gestão, divulgada pela Portaria SOF/ME nº 2.520/2022, e é composta de um rol de funções e subfunções prefixadas, que servem como agregador dos gastos públicos por área de ação governamental nas três esferas de Governo. Trata-se de uma classificação independente dos programas e de aplicação comum e obrigatória, no âmbito da União, dos Estados, do Distrito Federal e dos Municípios, o que permite a consolidação nacional dos gastos do setor público.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorFuncionalDeDespesa.codigoFuncao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorFuncionalDeDespesa.descricaoFuncao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorFuncionalDeDespesa.codigoSubFuncao ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorFuncionalDeDespesa.descricaoSubFuncao ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorEstruturaProgramaticaDeDespesa" ;
    rdfs:comment """Toda ação do Governo está estruturada em programas orientados para a realização dos objetivos estratégicos definidos no Plano Plurianual (PPA) para o período de quatro anos. Conforme estabelecido no art. 3º da Portaria SOF/SETO/ME nº 42/1999 (divulgada pela Portaria SOF/ME nº 2.520/2022), a União, os Estados, o Distrito Federal e os Municípios estabelecerão, em atos próprios, suas estruturas de programas, códigos e identificação, respeitados os conceitos e determinações nela contidos. Ou seja, todos os entes devem ter seus trabalhos organizados por programas e ações, mas cada um estabelecerá seus próprios programas e ações de acordo com a referida Portaria
Cite MCASP - 11º Edição: Parte I: Seção 4.2.3"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.codigoPrograma ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.descricaoPrograma ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.codigoAcao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.descricaoAcao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.codigoSubtitulo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.descricaoSubtitulo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.codigoPlanoOrcamentario ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.descricaoPlanoOrcamentario ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ClassificadorPorNaturezaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorNaturezaDeDespesa" ;
    rdfs:comment """A classificação da despesa orçamentária, segundo a sua natureza, compõe-se de: a. Categoria Econômica ; b. Grupo de Natureza da Despesa ; c. Elemento de Despesa.  A natureza da despesa será complementada pela informação gerencial denominada \"Modalidade de Aplicação\", a qual tem por finalidade indicar se os recursos são aplicados diretamente por órgãos ou entidades no âmbito da mesma esfera de Governo ou por outro ente da Federação e suas respectivas entidades, e objetiva, precipuamente, possibilitar a eliminação da dupla contagem dos recursos transferidos ou descentralizados.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.4"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.codigoCategoriaEconomica ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.descricaoCategoriaEconomica ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.codigoGrupoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.descricaoGrupoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.codigoModalidade ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.descricaoModalidade ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.codigoElementoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.descricaoElementoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.codigoSubElementoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificadorPorNaturezaDeDespesa.descricaoSubElementoDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:FonteDaDespesa a owl:Class, gufo:RoleMixin ;
    rdfs:label "FonteDaDespesa" ;
    rdfs:comment """A classificação por fontes ou destinações de recursos (FR) tem como objetivo agrupar receitas que possuam as mesmas normas de aplicação na despesa. Em regra, as fontes ou destinações de recursos reúnem recursos oriundos de determinados códigos da classificação por natureza da receita orçamentária, conforme regras previamente estabelecidas. Por meio do orçamento público, essas fontes ou destinações são associadas a determinadas despesas de forma a evidenciar os meios para atingir os objetivos públicos.
Cite MCASP - 11º Edição: Parte I: Seção 5.1
Na execução orçamentária da despesa, a FR estará associada, desde o momento do empenho, às contas de controle orçamentário (classe 6 do PCASP), às contas do passivo financeiro (classe 2 com atributo “F”) e às contas de controle da disponibilidade por destinação de recursos (na classe 8)
Cite MCASP - 11º Edição: Parte I: Seção 5.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:FonteOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:FonteDaDespesa.codigoFonte ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:FonteDaDespesa.descricaoFonte ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:FonteDaDespesa.codigoDetalhamentoFonte ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:FonteDaDespesa.descricaoDetalhamentoFonte ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.fonteClassificadaPor ] ;
          owl:someValuesFrom base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria ] .

base-despesas:PoderDaFederacaoNaDespesa a owl:Class, gufo:RoleMixin ;
    rdfs:label "PoderDaFederacaoNaDespesa" ;
    rdfs:comment "Poder da federação na despesa"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:PoderDaFederacao,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeRestosAPagar.mediatesPoderDaFederacaoNaDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeRestosAPagar ] .

base-despesas:RegistroDeDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeDespesaOrcamentaria" ;
    rdfs:comment "Registro que associa a despesa orçamentária à unidade gestora emitente, seus classificadores e seus dados."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.idRegistro ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.temDespesaOrcamentaria ;
          owl:onClass base-despesas:DespesaOrcamentariaRegistrada ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.temUnidadeGestoraDaDespesa ;
          owl:onClass base-despesas:UnidadeGestoraNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.classifica ] ;
          owl:onClass base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ProcessoOrcamentarioDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ProcessoOrcamentarioDeDespesa" ;
    rdfs:comment """Agrupamento de informações referentes ao processo orçamentário de uma despesa
codigo: Código do processo a que se refere à despesa
descricao: Conjunto de documentos, informações ou quaisquer outros elementos referenciados por um número de controle sequencial.
processoAssunto: Assunto referente ao processo."""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ProcessoOrcamentarioDeDespesa.codigo ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ProcessoOrcamentarioDeDespesa.descricao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ProcessoOrcamentarioDeDespesa.assunto ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesa.mediatesProcessoOrcamentarioDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesa ] .

base-despesas:RetencaoDaDespesa a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "RetencaoDaDespesa" ;
    rdfs:comment "Tipo de dados que agrupa os atributos referentes à retenção da despesa, junto ao credor da retenção."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        nucleo:DadosPessoaisAnonimizados,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RetencaoDaDespesa.tipoRetencao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RetencaoDaDespesa.nomeTipoRetencao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:LicitacaoDaDespesa a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "LicitacaoDaDespesa" ;
    rdfs:comment "Tipo de dados que agrupa os atributos referentes à licitação da despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:LicitacaoDaDespesa.tipoLicitacao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:LicitacaoDaDespesa.numeroLicitacao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:LicitacaoDaDespesa.anoLicitacao ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ValorAtreladoNoRegistroDeDespesa a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "ValorAtreladoNoRegistroDeDespesa" ;
    rdfs:comment "Tipo de dados que agrupa os valores monetários que um Registro de Despesa pode ter."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroDeDespesa.valorEmpenho ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroDeDespesa.valorLiquidado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroDeDespesa.valorPago ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroDeDespesa.valorRap ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeDespesa a owl:Class, gufo:SubKind ;
    rdfs:label "RegistroDeDespesa" ;
    rdfs:comment "Registro de Despesa orçamentária especifico para descrever o arquivo 'Despesas' no portal da transparencia"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:RegistroDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.data ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.emenda ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.embasamento ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.dadosDoFavorecido ;
          owl:onClass nucleo:DadosPessoaisAnonimizadosExpandido ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.valorAtrelado ;
          owl:onClass base-despesas:ValorAtreladoNoRegistroDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.retencaoDaDespesa ;
          owl:onClass base-despesas:RetencaoDaDespesa ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.historicoDocumento ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.documento ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.documentoEmpenho ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.idUso ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.descricaoIdUso ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.dadosRetencao ;
          owl:onClass base-despesas:RetencaoDaDespesa ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.dadosLicitacao ;
          owl:onClass base-despesas:LicitacaoDaDespesa ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.contratoDaDespesa ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.codigoGestaoEmitente ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.mediatesProcessoOrcamentarioDeDespesa ;
          owl:onClass base-despesas:ProcessoOrcamentarioDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.hasBancoNaDespesa ;
          owl:onClass base-despesas:BancoNaDespesa ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.hasConcedorDeConvenio ;
          owl:onClass base-despesas:ConcedorDeConvenio ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesa.hasRecebedorDeConvenio ;
          owl:onClass base-despesas:RecebedorDeConvenio ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ValorAtreladoNoRegistroRestosAPagar a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "ValorAtreladoNoRegistroRestosAPagar" ;
    rdfs:comment "Tipo de dados que agrupa os valores monetários que um Registro de Restos a Pagar pode ter."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroRestosAPagar.valorNaoProcessado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroRestosAPagar.valorProcessado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoRegistroRestosAPagar.valorNaoProcessadoLiquidado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeRestosAPagar a owl:Class, gufo:SubKind ;
    rdfs:label "RegistroDeRestosAPagar" ;
    rdfs:comment "Registro de Despesa orçamentária especifico para descrever o arquivo 'RestosAPagar' no portal da transparencia"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:RegistroDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.valorAtrelado ;
          owl:onClass base-despesas:ValorAtreladoNoRegistroRestosAPagar ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.idRegistro ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeRestosAPagar.mediatesPoderDaFederacaoNaDespesa ;
          owl:onClass base-despesas:PoderDaFederacaoNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:EsferaOrcamentariaNaDespesa a owl:Class, gufo:RoleMixin ;
    rdfs:label "EsferaOrcamentariaNaDespesa" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:EsferaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.mediatesEsferaOrcamentariaNaDespesa ] ;
          owl:someValuesFrom base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria ] .

base-despesas:ValorAtreladoNoOrcamentoDeDespesa a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "ValorAtreladoNoOrcamentoDeDespesa" ;
    rdfs:comment "Tipo de dados que agrupa os valores monetários que um Registro de Orçamento de Despesa pode ter."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeDespesa.dotacaoInicial ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeDespesa.dotacaoAtualizada ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeDespesa.despesaEmpenhada ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeDespesa.despesaLiquidada ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeDespesa.despesaPaga ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeOrcamentoDeDespesa a owl:Class, gufo:SubKind ;
    rdfs:label "RegistroDeOrcamentoDeDespesa" ;
    rdfs:comment "Registro de Despesa orçamentária especifico para descrever o arquivo 'OrcamentosDespesa' no portal da transparencia"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:RegistroDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.valorAtrelado ;
          owl:onClass base-despesas:ValorAtreladoNoOrcamentoDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.emenda ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.dadosDoFavorecido ;
          owl:onClass nucleo:DadosPessoaisAnonimizados ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMicroRegiaoNaDespesa ;
          owl:onClass base-despesas:MicroRegiaoNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMunicipioNaDespesa ;
          owl:onClass base-despesas:MunicipioNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "ValorAtreladoNoOrcamentoDeExecucaoDeDespesa" ;
    rdfs:comment "Tipo de dados que agrupa os valores monetários que um Registro de Orçamento de Execução pode ter."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:QualityValue,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorEmpenho ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorLiquidado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorPago ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorRap ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorOrcadoInicial ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa.valorOrcado ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeOrcamentoDeExecucao a owl:Class, gufo:SubKind ;
    rdfs:label "RegistroDeOrcamentoDeExecucao" ;
    rdfs:comment "Registro de Despesa orçamentária especifico para descrever o arquivo 'OrcamentosExecucoes' no portal da transparencia"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:RegistroDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeExecucao.data ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeOrcamentoDeExecucao.valorAtrelado ;
          owl:onClass base-despesas:ValorAtreladoNoOrcamentoDeExecucaoDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:MicroRegiaoNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "MicroRegiaoNaDespesa" ;
    rdfs:comment "MicroRegião na despesa orçamentária"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:MicroRegiao,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMicroRegiaoNaDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeDespesa ] .

base-despesas:MunicipioNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "MunicipioNaDespesa" ;
    rdfs:comment "Município na despesa orçamentária"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Municipio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeOrcamentoDeDespesa.mediatesMunicipioNaDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeOrcamentoDeDespesa ] .

base-despesas:BancoNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "BancoNaDespesa" ;
    rdfs:comment "Banco na despesa orçamentária"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Banco,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesa.hasBancoNaDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesa ] .

base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "ClassificacaoDoRegistroDeDespesaOrcamentaria" ;
    rdfs:comment "Relator que associa a Despesa às classificações que possui."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorInstitucionalDeDespesa.mediatesClassificacaoDoRegistroDeDespesaOrcamentaria ] ;
          owl:onClass base-despesas:ClassificadorInstitucionalDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.classifica ;
          owl:onClass base-despesas:RegistroDeDespesaOrcamentaria ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.funcionalClassificadaPor ;
          owl:onClass base-despesas:ClassificadorFuncionalDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.programaticaClassificadaPor ;
          owl:onClass base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.naturezaClassificadaPor ;
          owl:onClass base-despesas:ClassificadorPorNaturezaDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.fonteClassificadaPor ;
          owl:onClass base-despesas:FonteDaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:ClassificacaoDoRegistroDeDespesaOrcamentaria.mediatesEsferaOrcamentariaNaDespesa ;
          owl:onClass base-despesas:EsferaOrcamentariaNaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ConcedorDeConvenio a owl:Class, gufo:Role ;
    rdfs:label "ConcedorDeConvenio" ;
    rdfs:comment "Convenio que concede dinheiro à despesa orçamentária"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesa.hasConcedorDeConvenio ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesa ] .

base-despesas:RecebedorDeConvenio a owl:Class, gufo:Role ;
    rdfs:label "RecebedorDeConvenio" ;
    rdfs:comment "Convenio que recebe dinheiro da despesa orçamentária"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesa.hasRecebedorDeConvenio ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesa ] .

base-despesas:UnidadeGestoraNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraNaDespesa" ;
    rdfs:comment "Unidade gestora responsável pela emissão da despesa orçamentária."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.temUnidadeGestoraDaDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] .

base-despesas:OrgaoPublicoOrcamentarioNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "OrgaoPublicoOrcamentarioNaDespesa" ;
    rdfs:comment "Orgao público na despesa"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:OrgaoPublicoOrcamentario,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorInstitucionalDeDespesa.mediatesOrgaoPublicoOrcamentarioNaDespesa ] ;
          owl:someValuesFrom base-despesas:ClassificadorInstitucionalDeDespesa ] .

base-despesas:UnidadeOrcamentariaNaDespesa a owl:Class, gufo:Role ;
    rdfs:label "UnidadeOrcamentariaNaDespesa" ;
    rdfs:comment "Unidade orçamentária na despesa"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorInstitucionalDeDespesa.mediatesUnidadeOrcamentariaNaDespesa ] ;
          owl:someValuesFrom base-despesas:ClassificadorInstitucionalDeDespesa ] .

base-despesas:DespesaDeEmpenho a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDeEmpenho" ;
    rdfs:comment """Empenho, segundo o art. 58 da Lei nº 4.320/1964, é o ato emanado de autoridade competente que cria para o Estado obrigação de pagamento pendente ou não de implemento de condição. Consiste na reserva de dotação orçamentária para um fim específico.
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DespesaOrcamentaria .

base-despesas:DespesaDeLiquidacao a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDeLiquidacao" ;
    rdfs:comment """Conforme dispõe o art. 63 da Lei nº 4.320/1964, a liquidação consiste na verificação do direito adquirido pelo credor tendo por base os títulos e documentos comprobatórios do respectivo crédito
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.3"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DespesaOrcamentaria .

base-despesas:DespesaDePagamento a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDePagamento" ;
    rdfs:comment """O pagamento consiste na entrega de numerário ao credor por meio de cheque nominativo, ordens de pagamentos ou crédito em conta, e só pode ser efetuado após a regular liquidação da despesa. A Lei nº 4.320/1964, no art. 64, define ordem de pagamento como sendo o despacho exarado por autoridade competente, determinando que a despesa liquidada seja paga. A ordem de pagamento só pode ser exarada em documentos processados pelos serviços de contabilidade.
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.4"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DespesaOrcamentaria .

base-despesas:DespesaOrcamentariaRegistrada a owl:Class, gufo:Role ;
    rdfs:label "DespesaOrcamentariaRegistrada" ;
    rdfs:comment "Despesa orçamentária registrada por uma unidade gestora para funcionamento e manutenção dos serviços públicos."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaOrcamentariaRegistrada.ano ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.temDespesaOrcamentaria ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] .

base-despesas:DespesaDeExercicioVigente a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioVigente" ;
    rdfs:comment "Despesa empenhada que foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:DespesaDeExercicioAnterior a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioAnterior" ;
    rdfs:comment """São Restos a Pagar todas as despesas regularmente empenhadas, do exercício atual ou anterior, mas não pagas até 31 de dezembro do exercício financeiro vigente.
Cite MCASP - 11º Edição: Parte I: Seção 4.7"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:TerminoDoExercicioVigenteDaDespesa a owl:Class, gufo:SituationType ;
    rdfs:label "TerminoDoExercicioVigenteDaDespesa" ;
    rdfs:comment """No fim do exercício, as despesas orçamentárias empenhadas e não pagas serão inscritas em restos a pagar.
Cite MCASP - 11º Edição: Parte I: Seção 4.7.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:Situation .

base-despesas:CriacaoDeDespesaNaoPaga a owl:Class, gufo:EventType ;
    rdfs:label "CriacaoDeDespesaNaoPaga" ;
    rdfs:comment "Evento de criação de uma despesa empenhada que NÃO foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Event,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:TerminoDoExercicioVigenteDaDespesa.triggers ] ;
          owl:onClass base-despesas:TerminoDoExercicioVigenteDaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioVigente ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioAnterior ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:AllDisjointClasses ;
    owl:members (
        base-despesas:RegistroDeDespesa
        base-despesas:RegistroDeOrcamentoDeDespesa
        base-despesas:RegistroDeOrcamentoDeExecucao
        base-despesas:RegistroDeRestosAPagar
    ) .

[] a owl:AllDisjointClasses ;
    owl:members (
        base-despesas:DespesaDeExercicioAnterior
        base-despesas:DespesaDeExercicioVigente
    ) .

base-despesas:ClassificadorFuncionalDeDespesa.codigoFuncao a
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codigoFuncao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorFuncionalDeDespesa ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

base-despesas:ClassificadorFuncionalDeDespesa.descricaoFuncao a
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descricaoFuncao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorFuncionalDeDespesa ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

base-despesas:ClassificadorFuncionalDeDespesa.codigoSubFuncao a
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codigoSubFuncao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorFuncionalDeDespesa ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

base-despesas:ClassificadorFuncionalDeDespesa.descricaoSubFuncao a
        owl:DatatypeProperty,
