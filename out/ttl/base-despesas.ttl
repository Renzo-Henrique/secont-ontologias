# Written by `tonto gufo` from the tonto ontology base-despesas.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix base-despesas: <https://example.org/ontologia-portal-transparencia-es/base-despesas#> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/base-despesas> a owl:Ontology ;
    owl:imports
        <http://purl.org/nemo/gufo#>,
        <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    vann:preferredNamespacePrefix "base-despesas" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/base-despesas#" .

base-despesas:DocumentoContabilDeDespesaOrcamentaria a owl:Class, gufo:SubKind ;
    rdfs:label "DocumentoContabilDeDespesaOrcamentaria" ;
    rdfs:comment """Despesa orçamentária é toda transação que depende de autorização legislativa, na forma de consignação de dotação orçamentária, para ser efetivada.
Cite MCASP - 11º Edição: Parte I: Seção 4.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:DocumentoContabil,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorInstitucionalDeDespesa.classifica ] ;
          owl:someValuesFrom base-despesas:ClassificadorInstitucionalDeDespesa ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorFuncionalDeDespesa.classifica ] ;
          owl:someValuesFrom base-despesas:ClassificadorFuncionalDeDespesa ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.classifica ] ;
          owl:someValuesFrom base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:ClassificadorPorNaturezaDeDespesa.classifica ] ;
          owl:someValuesFrom base-despesas:ClassificadorPorNaturezaDeDespesa ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:FonteDaDespesa.classifica ] ;
          owl:someValuesFrom base-despesas:FonteDaDespesa ] ;
    owl:equivalentClass
        [ a owl:Class ;
          owl:unionOf (
              base-despesas:DespesaDeEmpenho
              base-despesas:DespesaDeLiquidacao
              base-despesas:DespesaDePagamento
          ) ],
        [ a owl:Class ;
          owl:unionOf (
              base-despesas:DespesaDeExercicioAnterior
              base-despesas:DespesaDeExercicioVigente
          ) ] .

base-despesas:ClassificadorInstitucionalDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorInstitucionalDeDespesa" ;
    rdfs:comment """A classificação institucional reflete a estrutura de alocação dos créditos orçamentários e está estruturada em dois níveis hierárquicos: órgão orçamentário e unidade orçamentária. Constitui unidade orçamentária o agrupamento de serviços subordinados ao mesmo órgão ou repartição a que serão consignadas dotações próprias (art. 14 da Lei nº 4.320/1964).
Cite MCASP - 11º Edição: Parte I: Seção 4.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-despesas:ClassificadorFuncionalDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorFuncionalDeDespesa" ;
    rdfs:comment """A classificação funcional segrega as dotações orçamentárias em funções e subfunções, buscando responder basicamente à indagação \"em que área\" de ação governamental a despesa será realizada. A atual classificação funcional foi instituída pela Portaria nº 42/1999, do então Ministério do Orçamento e Gestão, divulgada pela Portaria SOF/ME nº 2.520/2022, e é composta de um rol de funções e subfunções prefixadas, que servem como agregador dos gastos públicos por área de ação governamental nas três esferas de Governo. Trata-se de uma classificação independente dos programas e de aplicação comum e obrigatória, no âmbito da União, dos Estados, do Distrito Federal e dos Municípios, o que permite a consolidação nacional dos gastos do setor público.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorEstruturaProgramaticaDeDespesa" ;
    rdfs:comment """Toda ação do Governo está estruturada em programas orientados para a realização dos objetivos estratégicos definidos no Plano Plurianual (PPA) para o período de quatro anos. Conforme estabelecido no art. 3º da Portaria SOF/SETO/ME nº 42/1999 (divulgada pela Portaria SOF/ME nº 2.520/2022), a União, os Estados, o Distrito Federal e os Municípios estabelecerão, em atos próprios, suas estruturas de programas, códigos e identificação, respeitados os conceitos e determinações nela contidos. Ou seja, todos os entes devem ter seus trabalhos organizados por programas e ações, mas cada um estabelecerá seus próprios programas e ações de acordo com a referida Portaria
Cite MCASP - 11º Edição: Parte I: Seção 4.2.3
Na União, o subtítulo representa o menor nível de categoria de programação e será detalhado por esfera orçamentária (fiscal, seguridade e investimento), grupo de natureza de despesa, modalidade de aplicação, identificador de resultado primário, identificador de uso e fonte de recursos, sendo o produto e a unidade de medida os mesmos da ação orçamentária.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.3.3"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-despesas:ClassificadorPorNaturezaDeDespesa a owl:Class, gufo:Category ;
    rdfs:label "ClassificadorPorNaturezaDeDespesa" ;
    rdfs:comment """A classificação da despesa orçamentária, segundo a sua natureza, compõe-se de: a. Categoria Econômica ; b. Grupo de Natureza da Despesa ; c. Elemento de Despesa.  A natureza da despesa será complementada pela informação gerencial denominada \"Modalidade de Aplicação\", a qual tem por finalidade indicar se os recursos são aplicados diretamente por órgãos ou entidades no âmbito da mesma esfera de Governo ou por outro ente da Federação e suas respectivas entidades, e objetiva, precipuamente, possibilitar a eliminação da dupla contagem dos recursos transferidos ou descentralizados.
Cite MCASP - 11º Edição: Parte I: Seção 4.2.4"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-despesas:FonteDaDespesa a owl:Class, gufo:Category ;
    rdfs:label "FonteDaDespesa" ;
    rdfs:comment """A classificação por fontes ou destinações de recursos (FR) tem como objetivo agrupar receitas que possuam as mesmas normas de aplicação na despesa. Em regra, as fontes ou destinações de recursos reúnem recursos oriundos de determinados códigos da classificação por natureza da receita orçamentária, conforme regras previamente estabelecidas. Por meio do orçamento público, essas fontes ou destinações são associadas a determinadas despesas de forma a evidenciar os meios para atingir os objetivos públicos.
Cite MCASP - 11º Edição: Parte I: Seção 5.1
Na execução orçamentária da despesa, a FR estará associada, desde o momento do empenho, às contas de controle orçamentário (classe 6 do PCASP), às contas do passivo financeiro (classe 2 com atributo “F”) e às contas de controle da disponibilidade por destinação de recursos (na classe 8)
Cite MCASP - 11º Edição: Parte I: Seção 5.2"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:FunctionalComplex .

base-despesas:RegistroDeDespesaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeDespesaOrcamentaria" ;
    rdfs:comment "Registro que associa o documento contábil de despesa à unidade gestora emitente."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.dadosAnonimizados ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.poder ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.mediatesDespesaRegistrada ;
          owl:onClass base-despesas:DespesaRegistrada ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentaria.mediatesUnidadeGestoraEmitenteDeDespesa ;
          owl:onClass base-despesas:UnidadeGestoraEmitenteDeDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RegistroDeDespesaOrcamentariaComOpcionais a owl:Class, gufo:SubKind ;
    rdfs:label "RegistroDeDespesaOrcamentariaComOpcionais" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:RegistroDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasMicroRegiao ;
          owl:onClass nucleo:MicroRegiao ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasMunicipio ;
          owl:onClass nucleo:Municipio ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasBanco ;
          owl:onClass nucleo:Banco ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasConcedorDeConvenio ;
          owl:onClass base-despesas:ConcedorDeConvenio ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasRecebedorDeConvenio ;
          owl:onClass base-despesas:RecebedorDeConvenio ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:ConcedorDeConvenio a owl:Class, gufo:Role ;
    rdfs:label "ConcedorDeConvenio" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasConcedorDeConvenio ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentariaComOpcionais ] .

base-despesas:RecebedorDeConvenio a owl:Class, gufo:Role ;
    rdfs:label "RecebedorDeConvenio" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:Convenio,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentariaComOpcionais.hasRecebedorDeConvenio ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentariaComOpcionais ] .

base-despesas:Despesa a owl:Class, gufo:Role ;
    rdfs:label "Despesa" ;
    rdfs:comment "Documento contabil referente aos arquivos \"Despesas\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaDeExercicioVigente,
        base-despesas:DespesaDePagamento,
        base-despesas:DespesaRegistrada .

base-despesas:UnidadeGestoraEmitenteDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestoraEmitenteDeDespesa" ;
    rdfs:comment "Unidade gestora responsável pela emissão do documento contábil de despesa."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        nucleo:UnidadeGestora,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.mediatesUnidadeGestoraEmitenteDeDespesa ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] .

base-despesas:DespesaDeEmpenho a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDeEmpenho" ;
    rdfs:comment """A etapa do planejamento abrange, de modo geral, toda a análise para a formulação do plano e ações governamentais que servirão de base para a fixação da despesa orçamentária, a descentralização/movimentação de créditos, a programação orçamentária e financeira, e o processo de licitação e contratação.
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:DespesaDeLiquidacao a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDeLiquidacao" ;
    rdfs:comment """Conforme dispõe o art. 63 da Lei nº 4.320/1964, a liquidação consiste na verificação do direito adquirido pelo credor tendo por base os títulos e documentos comprobatórios do respectivo crédito
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.3"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:DespesaDePagamento a owl:Class, gufo:Phase ;
    rdfs:label "DespesaDePagamento" ;
    rdfs:comment """O pagamento consiste na entrega de numerário ao credor por meio de cheque nominativo, ordens de pagamentos ou crédito em conta, e só pode ser efetuado após a regular liquidação da despesa. A Lei nº 4.320/1964, no art. 64, define ordem de pagamento como sendo o despacho exarado por autoridade competente, determinando que a despesa liquidada seja paga. A ordem de pagamento só pode ser exarada em documentos processados pelos serviços de contabilidade.
Cite MCASP - 11º Edição: Parte I: Seção 4.4.2.4"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:DespesaRegistrada a owl:Class, gufo:RoleMixin ;
    rdfs:label "DespesaRegistrada" ;
    rdfs:comment "Agrupa os papeis das despesas que são representadas por arquivos no Portal da Transparência." ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:RegistroDeDespesaOrcamentaria.mediatesDespesaRegistrada ] ;
          owl:someValuesFrom base-despesas:RegistroDeDespesaOrcamentaria ] ;
    owl:equivalentClass [ a owl:Class ;
                          owl:unionOf (
                              base-despesas:Despesa
                              base-despesas:OrcamentoDeDespesa
                              base-despesas:RestosAPagar
                          ) ] .

base-despesas:DespesaDeExercicioVigente a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioVigente" ;
    rdfs:comment "Despesa empenhada que foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:DespesaDeExercicioAnterior a owl:Class, gufo:SubKind ;
    rdfs:label "DespesaDeExercicioAnterior" ;
    rdfs:comment """São Restos a Pagar todas as despesas regularmente empenhadas, do exercício atual ou anterior, mas não pagas até 31 de dezembro do exercício financeiro vigente.
Cite MCASP - 11º Edição: Parte I: Seção 4.7"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DocumentoContabilDeDespesaOrcamentaria,
        [ a owl:Restriction ;
          owl:onProperty base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ;
          owl:onClass base-despesas:CriacaoDeDespesaNaoPaga ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:TerminoDoExercicioVigenteDaDespesa a owl:Class, gufo:SituationType ;
    rdfs:label "TerminoDoExercicioVigenteDaDespesa" ;
    rdfs:comment """No fim do exercício, as despesas orçamentárias empenhadas e não pagas serão inscritas em restos a pagar.
Cite MCASP - 11º Edição: Parte I: Seção 4.7.1"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf gufo:Situation .

base-despesas:CriacaoDeDespesaNaoPaga a owl:Class, gufo:EventType ;
    rdfs:label "CriacaoDeDespesaNaoPaga" ;
    rdfs:comment "Evento de criação de uma despesa empenhada que NÃO foi paga no mesmo exercício vigente em que foi emitida"@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        gufo:Event,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:TerminoDoExercicioVigenteDaDespesa.triggers ] ;
          owl:onClass base-despesas:TerminoDoExercicioVigenteDaDespesa ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioVigente.wasTerminatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioVigente ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf base-despesas:DespesaDeExercicioAnterior.wasCreatedInCriacaoDeDespesaNaoPaga ] ;
          owl:onClass base-despesas:DespesaDeExercicioAnterior ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

base-despesas:RestosAPagar a owl:Class, gufo:Role ;
    rdfs:label "RestosAPagar" ;
    rdfs:comment "Documento contabil referente aos arquivos \"RestosAPagar\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf
        base-despesas:DespesaDeExercicioAnterior,
        base-despesas:DespesaDePagamento,
        base-despesas:DespesaRegistrada .

base-despesas:OrcamentoDeDespesa a owl:Class, gufo:Role ;
    rdfs:label "OrcamentoDeDespesa" ;
    rdfs:comment "Documento contabil referente aos arquivos \"OrcamentosDespesa\""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:subClassOf base-despesas:DespesaDeEmpenho, base-despesas:DespesaRegistrada .

[] a owl:AllDisjointClasses ;
    owl:members (
        base-despesas:DespesaDeExercicioAnterior
        base-despesas:DespesaDeExercicioVigente
    ) .

base-despesas:RegistroDeDespesaOrcamentaria.dadosAnonimizados a
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dadosAnonimizados" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:RegistroDeDespesaOrcamentaria ;
    rdfs:range nucleo:DadosPessoaisAnonimizados ;
    rdfs:subPropertyOf gufo:hasQualityValue .

base-despesas:RegistroDeDespesaOrcamentaria.poder a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "poder" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:RegistroDeDespesaOrcamentaria ;
    rdfs:range nucleo:PoderDaFederacao ;
    rdfs:subPropertyOf gufo:hasQualityValue .

base-despesas:ClassificadorInstitucionalDeDespesa.classifica a owl:ObjectProperty ;
    rdfs:label "classifica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorInstitucionalDeDespesa ;
    rdfs:range base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:ClassificadorFuncionalDeDespesa.classifica a owl:ObjectProperty ;
    rdfs:label "classifica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorFuncionalDeDespesa ;
    rdfs:range base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa.classifica a owl:ObjectProperty ;
    rdfs:label "classifica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorPorEstruturaProgramaticaDeDespesa ;
    rdfs:range base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:ClassificadorPorNaturezaDeDespesa.classifica a owl:ObjectProperty ;
    rdfs:label "classifica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:ClassificadorPorNaturezaDeDespesa ;
    rdfs:range base-despesas:DocumentoContabilDeDespesaOrcamentaria .

base-despesas:FonteDaDespesa.classifica a owl:ObjectProperty ;
    rdfs:label "classifica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:FonteDaDespesa ;
