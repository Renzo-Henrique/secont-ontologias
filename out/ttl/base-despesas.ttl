base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesDespesaOrcamentaria a
        owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesDespesaOrcamentaria" ;
