base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria.mediatesDespesaOrcamentaria a
        owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "RegistroDeConvenioConcedidoNaDespesaOrcamentaria.mediatesDespesaOrcamentaria" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
    rdfs:domain base-despesas:RegistroDeConvenioConcedidoNaDespesaOrcamentaria ;
    rdfs:range base-despesas:DespesaOrcamentaria ;
    rdfs:subPropertyOf gufo:mediates .

base-despesas:RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesConvenioRecebido a
        owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "RegistroDeConvenioRecebidoNaDespesaOrcamentaria.mediatesConvenioRecebido" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/base-despesas> ;
