# Written by `tonto gufo` from the tonto ontology nucleo.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix nucleo: <https://example.org/ontologia-portal-transparencia-es/nucleo#> .

<https://example.org/ontologia-portal-transparencia-es/nucleo> a owl:Ontology ;
    owl:imports <http://purl.org/nemo/gufo#> ;
    vann:preferredNamespacePrefix "nucleo" ;
    vann:preferredNamespaceUri "https://example.org/ontologia-portal-transparencia-es/nucleo#" .

nucleo:UnidadeGestora a owl:Class, gufo:Role ;
    rdfs:label "UnidadeGestora" ;
    rdfs:comment """44 Portaria MTP 1.467/2022, Art.2º - Definições: VI - unidade gestora: entidade ou órgão único, de natureza pública, de cada ente federativo, abrangendo todos os poderes, órgãos e entidades autárquicas e fundacionais, que tenha por finalidade a administração, o gerenciamento e a operacionalização do RPPS, incluindo a arrecada.
Cite Portaria MTP nº 1.467, de 2 junho de 2022: Capítulo I - Definições"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf nucleo:OrgaoPublico .

nucleo:EntidadePublica a owl:Class, gufo:Role ;
    rdfs:label "EntidadePublica" ;
    rdfs:comment """É a unidade de atuação dotada de personalidade jurídica;;
Cite LEI Nº 9.784 , DE 29 DE JANEIRO DE 1999."""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        nucleo:PessoaJuridica,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf nucleo:OrgaoPublico.isComponentOfEntidadePublica ] ;
          owl:someValuesFrom nucleo:OrgaoPublico ] .

nucleo:OrgaoPublico a owl:Class, gufo:Kind ;
    rdfs:label "OrgaoPublico" ;
    rdfs:comment """É a unidade de atuação integrante da estrutura da Administração direta e da estrutura da Administração indireta;
Cite LEI Nº 9.784 , DE 29 DE JANEIRO DE 1999."""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:OrgaoPublico.codigo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:OrgaoPublico.descricao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:OrgaoPublico.isComponentOfEntidadePublica ;
          owl:onClass nucleo:EntidadePublica ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf nucleo:UnidadeDeOrgaoPublico.isComponentOfOrgaoPublico ] ;
          owl:someValuesFrom nucleo:UnidadeDeOrgaoPublico ] .

nucleo:UnidadeDeOrgaoPublico a owl:Class, gufo:Kind ;
    rdfs:label "UnidadeDeOrgaoPublico" ;
    rdfs:comment """Constitui unidade orçamentária o agrupamento de serviços subordinados ao mesmo órgão ou repartição a que serão consignadas dotações próprias.
Cite LEI No 4.320, DE 17 DE MARÇO DE 1964"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:UnidadeDeOrgaoPublico.codigo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:UnidadeDeOrgaoPublico.descricao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:UnidadeDeOrgaoPublico.isComponentOfOrgaoPublico ;
          owl:onClass nucleo:OrgaoPublico ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

nucleo:PessoaFisica a owl:Class, gufo:Kind ;
    rdfs:label "PessoaFisica" ;
    rdfs:comment "Pessoa natural identificada no modelo por CPF e nome, podendo também ter NIS informado."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:PessoaFisica.cpf ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:PessoaFisica.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

nucleo:PessoaJuridica a owl:Class, gufo:Kind ;
    rdfs:label "PessoaJuridica" ;
    rdfs:comment "Entidade com personalidade jurídica identificada no modelo por CNPJ e nome."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:PessoaJuridica.cnpj ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty nucleo:PessoaJuridica.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

nucleo:Regiao a owl:Class, gufo:Kind ;
    rdfs:label "Regiao" ;
    rdfs:comment "Unidade territorial usada para agrupar municípios no contexto geográfico da ontologia."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf gufo:FunctionalComplex .

nucleo:MicroRegiao a owl:Class, gufo:Kind ;
    rdfs:label "MicroRegiao" ;
    rdfs:comment "Recorte geográfico formado por municípios e vinculado a uma região no modelo."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:MicroRegiao.isComponentOfRegiao ;
          owl:onClass nucleo:Regiao ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

nucleo:Municipio a owl:Class, gufo:Kind ;
    rdfs:label "Municipio" ;
    rdfs:comment "Unidade territorial municipal relacionada à região e à microrregião correspondentes."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty nucleo:Municipio.isComponentOfRegiao ;
          owl:onClass nucleo:Regiao ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

nucleo:Banco a owl:Class, gufo:Kind ;
    rdfs:label "Banco" ;
    rdfs:comment "Instituição financeira referenciada nos dados do Portal da Transparência."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf gufo:FunctionalComplex .

nucleo:Convenio a owl:Class, gufo:Kind ;
    rdfs:label "Convenio" ;
    rdfs:comment """Convênios, contratos de repasse e termos de parceria são acordos feitos entre União e entidades governamentais dos demais entes da Federação, ou organizações não-governamentais, para transferência de recursos financeiros a serem utilizados na execução de um objetivo comum. Portanto, as transferências voluntárias e legais serão viabilizadas a partir dos mencionados instrumentos e outros congêneres.
Cite url https://portaldatransparencia.gov.br/entenda-a-gestao-publica/convenios-e-outros-acordos"""@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf gufo:FunctionalComplex .

nucleo:PoderDaFederacao a rdfs:Datatype ;
    rdfs:label "PoderDaFederacao" ;
    rdfs:comment "Classificação que identifica o Poder da Federação ao qual uma unidade gestora está vinculada."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    owl:equivalentClass rdfs:Literal .

nucleo:DadosPessoaisAnonimizados a rdfs:Datatype ;
    rdfs:label "DadosPessoaisAnonimizados" ;
    rdfs:comment "Representação de informações pessoais que foram submetidas a processo de anonimização."@pt-br ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    owl:equivalentClass rdfs:Literal .

nucleo:FonteOrcamentaria a owl:Class, gufo:Category ;
    rdfs:label "FonteOrcamentaria" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:subClassOf gufo:FunctionalComplex .

nucleo:OrgaoPublico.codigo a owl:DatatypeProperty ;
    rdfs:label "codigo" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:OrgaoPublico ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:OrgaoPublico.descricao a owl:DatatypeProperty ;
    rdfs:label "descricao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:OrgaoPublico ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:UnidadeDeOrgaoPublico.codigo a owl:DatatypeProperty ;
    rdfs:label "codigo" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:UnidadeDeOrgaoPublico ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:UnidadeDeOrgaoPublico.descricao a owl:DatatypeProperty ;
    rdfs:label "descricao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:UnidadeDeOrgaoPublico ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:PessoaFisica.cpf a owl:DatatypeProperty ;
    rdfs:label "cpf" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:PessoaFisica ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:PessoaFisica.nis a owl:DatatypeProperty ;
    rdfs:label "nis" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:PessoaFisica ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:PessoaFisica.nome a owl:DatatypeProperty ;
    rdfs:label "nome" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:PessoaFisica ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:PessoaJuridica.cnpj a owl:DatatypeProperty ;
    rdfs:label "cnpj" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:PessoaJuridica ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:PessoaJuridica.nome a owl:DatatypeProperty ;
    rdfs:label "nome" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:PessoaJuridica ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

nucleo:OrgaoPublico.isComponentOfEntidadePublica a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "OrgaoPublico.isComponentOfEntidadePublica" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:OrgaoPublico ;
    rdfs:range nucleo:EntidadePublica ;
    rdfs:subPropertyOf gufo:isComponentOf .

nucleo:UnidadeDeOrgaoPublico.isComponentOfOrgaoPublico a
        owl:ObjectProperty,
        owl:FunctionalProperty ;
    rdfs:label "UnidadeDeOrgaoPublico.isComponentOfOrgaoPublico" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:UnidadeDeOrgaoPublico ;
    rdfs:range nucleo:OrgaoPublico ;
    rdfs:subPropertyOf gufo:isComponentOf .

nucleo:MicroRegiao.isComponentOfRegiao a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "MicroRegiao.isComponentOfRegiao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:MicroRegiao ;
    rdfs:range nucleo:Regiao ;
    rdfs:subPropertyOf gufo:isComponentOf .

nucleo:Municipio.isComponentOfRegiao a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "Municipio.isComponentOfRegiao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:Municipio ;
    rdfs:range nucleo:Regiao ;
    rdfs:subPropertyOf gufo:isComponentOf .

nucleo:Municipio.isComponentOfMicroRegiao a owl:ObjectProperty ;
    rdfs:label "Municipio.isComponentOfMicroRegiao" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/nucleo> ;
    rdfs:domain nucleo:Municipio ;
    rdfs:range nucleo:MicroRegiao ;
    rdfs:subPropertyOf gufo:isComponentOf .

[] a owl:AllDisjointClasses ;
    owl:members (
        nucleo:Banco
        nucleo:Convenio
        nucleo:MicroRegiao
        nucleo:Municipio
        nucleo:OrgaoPublico
        nucleo:PessoaFisica
        nucleo:PessoaJuridica
        nucleo:Regiao
        nucleo:UnidadeDeOrgaoPublico
    ) .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .
