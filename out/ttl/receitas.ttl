          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorArrecadada ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorRecolhida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.tipoLancamento ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.dataEmissao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.dataContabilizacao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.documento ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.tipo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorPrevistaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorPrevistaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorPrevistaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorArrecadadaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorArrecadadaDeducao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorArrecadadaLiquida ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.valorRecolhidaBruta ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.ano ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf receitas:RegistroDeReceitaOrcamentaria.formalizadaPor ] ;
          owl:someValuesFrom receitas:RegistroDeReceitaOrcamentaria ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.emitidaPor ;
          owl:someValuesFrom receitas:UnidadeGestoraEmitenteDeReceita ],
        [ a owl:Restriction ;
          owl:onProperty receitas:DocumentoContabilDeReceita.emitidaPara ;
          owl:someValuesFrom receitas:UnidadeGestoraBeneficiadaDeReceita ] .

receitas:RegistroDeReceitaOrcamentaria a owl:Class, gufo:Kind ;
    rdfs:label "RegistroDeReceitaOrcamentaria" ;
    rdfs:isDefinedBy <https://example.org/ontologia-portal-transparencia-es/receitas> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty receitas:RegistroDeReceitaOrcamentaria.formalizadaPor ;
          owl:onClass receitas:DocumentoContabilDeReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraEmitente ;
          owl:onClass receitas:UnidadeGestoraEmitenteDeReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty receitas:RegistroDeReceitaOrcamentaria.temUnidadeGestoraBeneficiada ;
          owl:onClass receitas:UnidadeGestoraBeneficiadaDeReceita ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

